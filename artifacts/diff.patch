+# Schema gate for _llm_envelope_parse --schema-gate. A valid lens response must
+# be an object with score:number and findings:array (ADR-028 v1.2, #1843).
+_rr_lens_envelope_schema_ok() {
+    printf '%s' "${1:-}" | jq -e '
