diff --git a/plugins/agent/intake/lib/sanitize.sh b/plugins/agent/intake/lib/sanitize.sh
index b53ab6ae..7e71608b 100644
--- a/plugins/agent/intake/lib/sanitize.sh
+++ b/plugins/agent/intake/lib/sanitize.sh
@@ -34,5 +34,20 @@ _intake_strip_synthesized() {
     _s="${_s%%$'\n\n## Previous Session Context'*}"
     _s="${_s%%$'\n\nWARNING: Memory system'*}"
 
+    # If the result still starts with a sentinel header, the original goal had no
+    # real content before it — the entire goal is synthetic pipeline context.
+    # Consistent with the %% strips above: these markers mean "stop here" even at
+    # position 0, so a goal that IS only the sentinel strips to empty (#1837).
+    case "$_s" in
+        "## Plan Summary"*|"## Key Design Decisions"*|"IMPORTANT (TDD mode)"*|\
+        "Historical context"*|"Discoveries from"*|"File hotspots"*|\
+        "Active security alerts"*|"Coverage baseline"*|"## Skill Guidance"*|\
+        "## Historical Build Context"*|"BLOCKING ISSUES"*|\
+        "IMPORTANT — Previous build"*|"IMPORTANT — Code review"*|\
+        "IMPORTANT — Architecture"*|"IMPORTANT — Compound quality"*|\
+        "HUMAN FEEDBACK"*|"## Previous Session Context"*|\
+        "WARNING: Memory system"*) _s="" ;;
+    esac
+
     printf '%s' "$_s"
 }
