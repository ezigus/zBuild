diff --git a/tests/integration/resume-loop-state-test.sh b/tests/integration/resume-loop-state-test.sh
index c050e4b8..87ab7c15 100644
--- a/tests/integration/resume-loop-state-test.sh
+++ b/tests/integration/resume-loop-state-test.sh
@@ -269,6 +269,81 @@ assert_eq \
     "[#1805/CMBR-1] stage.start emitted for 'test' in iter 2 (interrupted cycle member dispatched on resume)" \
     "1" "$_CMBR1_TEST_DISPATCHED"
 
+# ── [#1805/CMBR-1] iter=1 scenario: most common interruption point ────────────
+# Red-team finding: CMBR-1 skip guard must work for any interrupted iteration,
+# including iter=1 (the most common first-failure point). The guard must NOT
+# require _start_iter > 1; if it does, complete iter-1 members are re-dispatched.
+print_test_section "[#1805/CMBR-1] iter=1 interrupted: build complete in iter=1 is skipped, test dispatched"
+
+# Given — a run is being resumed; in the interrupted iteration (iter 1), member
+#   stage "build" completed and member stage "test" was interrupted before
+#   completing; persisted state records build as complete within iter 1.
+#   _ZBUILD_RESUME_ACTIVE=true is exported.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+
+# Use zb_engine_loop_state to write cycle state: 1 round → current_iter=1
+# (interrupted during iter 1; this is the most common interruption scenario).
+# cycle_iterations["build-test"].current_iter = 1 (_start_iter = 1 on resume).
+zb_engine_loop_state "$STATE_FILE" "build-test" 1 5 "in_progress"
+
+# Record that "build" completed in iter 1 before the interruption.
+# stage_statuses.build = "complete" is what the cycle orchestrator checks to
+# decide whether to skip a member on resume (ADR-006 §3.6 / CMBR-1).
+jq '.stage_statuses.build = "complete"' "$STATE_FILE" \
+    > "${STATE_FILE}.cmbr1i1.tmp" && mv "${STATE_FILE}.cmbr1i1.tmp" "$STATE_FILE"
+
+# Load the template: same cycle-converges-iter2.yaml, build + test as cycle members.
+load_template "$FIXT/cycle-converges-iter2.yaml"
+
+# Track which cycle members are dispatched. cycle_dispatch_stage causes stage.start
+# events in a unit-test context; not being called for "build" is functionally
+# equivalent to no stage.start for build.
+_CMBR1I1_BUILD_DISPATCHED=0
+_CMBR1I1_TEST_DISPATCHED=0
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$stage" == "build" ]]; then
+        _CMBR1I1_BUILD_DISPATCHED=1
+    elif [[ "$stage" == "test" ]]; then
+        _CMBR1I1_TEST_DISPATCHED=1
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+zb_stub_reports_tests test
+
+# When — _ZBUILD_RESUME_ACTIVE=true is exported and the cycle orchestrator
+#   dispatches members of iter 1. "build" is complete; "test" is pending.
+set +e
+export _ZBUILD_RESUME_ACTIVE=true
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_cmbr1i1_rc=$?
+set -e
+
+# Then — no stage.start event for "build" (already complete in iter 1).
+# cycle_dispatch_stage must NOT be called for "build" in iter 1.
+# Before the fix: CMBR-1 guard requires _start_iter > 1; for _start_iter=1 the
+#   condition is false, _cid_resume_first_iter stays false → build IS dispatched →
+#   _CMBR1I1_BUILD_DISPATCHED=1 → assert 0==1 → FAILS (exposes the code bug).
+# After the fix: guard works for _start_iter=1 too → build is skipped →
+#   _CMBR1I1_BUILD_DISPATCHED=0 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] no stage.start for 'build' in iter 1 (complete member skipped on resume within interrupted iter=1; CMBR-1 guard must work for _start_iter=1 not only _start_iter>1)" \
+    "0" "$_CMBR1I1_BUILD_DISPATCHED"
+
+# Then — stage.start is emitted for "test" (the interrupted member of iter 1).
+# cycle_dispatch_stage must be called for "test" in iter 1.
+# Before the fix: build is re-dispatched and test may also run, but the guard
+#   failure means the skip invariant is violated.
+# After the fix: build is skipped, test is dispatched →
+#   _CMBR1I1_TEST_DISPATCHED=1 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] stage.start emitted for 'test' in iter 1 (interrupted cycle member dispatched; CMBR-1 applies to iter=1 not only iter>1)" \
+    "1" "$_CMBR1I1_TEST_DISPATCHED"
+
 # ── CYCL-1: test uses a fixture containing a cyclic stage ────────────────────
 print_test_section "resume-loop-state test uses a fixture containing a cyclic stage"
 
diff --git a/tests/integration/resume-rehydrate-test.sh b/tests/integration/resume-rehydrate-test.sh
index ab27fe18..cf5a51fa 100644
--- a/tests/integration/resume-rehydrate-test.sh
+++ b/tests/integration/resume-rehydrate-test.sh
@@ -237,6 +237,23 @@ fi
 assert_gt "[#1805/DSPK-1] stage k (cyc → member cycled) dispatched and emits stage.start on resume (interrupted stage was dispatched)" \
     "$_s1_cycled_starts" "0"
 
+# [#1805/DSPK-1]: when k is a cycle stage, cycle.start must be emitted for k (cyc) itself.
+# The requirement says: "when k is a cycle stage, a cycle.start event is emitted for k AND
+# stage.start is emitted for k's first cycle member". The cycled member's stage.start
+# (above) proves the member was dispatched. This assertion proves the cycle stage itself
+# (cyc) emitted cycle.start — the cycle.start half of the DSPK-1 Then clause.
+# Before the change: runner may abort before dispatching cyc → no cycle.start emitted
+#   → count=0 → FAILS.
+# After the change: rehydrate → dispatch loop reaches cyc → cycle.start emitted for cyc
+#   → count=1 → PASSES.
+_s1_cyc_cycle_starts=0
+if [[ -f "$S1_EVENTS_JSONL" ]]; then
+    _s1_cyc_cycle_starts="$(jq -r 'select(.type=="cycle.start") | .type' \
+        "$S1_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+fi
+assert_gt "[#1805/DSPK-1] cycle.start emitted for stage k (cyc) on resume (cycle.start half of Then: cycle stage k was dispatched)" \
+    "$_s1_cyc_cycle_starts" "0"
+
 # ── SPEC-1 path 2: auto-resume on status=interrupted ─────────────────────────
 # [#1805/RHYD-1] all entry paths: path 2 — auto-resume when status=interrupted.
 # No --resume flag; runner detects interrupted status and auto-resumes.
@@ -764,6 +781,25 @@ _s12_fixt_content="$(cat "$REPO_ROOT/tests/fixtures/templates/artifact-snapshot-
 assert_contains "cycle fixture used in fresh-run sub-case has type: cycle" \
     "$_s12_fixt_content" "type: cycle"
 
+# [#1805/FRSH-1]: a fresh run must NOT emit stage.start for cycle members (cycled).
+# Design (Gap 7): stage.start for cycle members is only emitted via the CMBR-1
+# resume_first_iter=true path; it must NOT fire unconditionally on fresh runs.
+# Before this change (pre-#1805): cycle members never emitted stage.start (they emit
+#   cycle.member.dispatch.{start,complete} instead); _s12_cycled_starts=0 → PASSES (no-code ✓).
+# After this change with the iter>0 guard bug: stage.start fires for every cycle member
+#   dispatch unconditionally (iter starts at 1, so iter>0 is always true) → cycled emits
+#   stage.start on fresh runs → _s12_cycled_starts=1 → assert 0==1 → FAILS (exposes bug).
+# After fix (iter>0 guard removed or guarded by _ZBUILD_RESUME_ACTIVE):
+#   cycle members emit stage.start only via CMBR-1 resume path → 0 on fresh run → PASSES.
+# This covers GUAR-1 on the cycle-member side (the gap red-team finding 4 names).
+_s12_cycled_starts=0
+if [[ -f "$S12_EVENTS_JSONL" ]]; then
+    _s12_cycled_starts="$(jq -r 'select(.type=="stage.start" and .data.stage=="cycled") | .type' \
+        "$S12_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+fi
+assert_eq "[#1805/FRSH-1] no stage.start for cycle member (cycled) on fresh run (cycle members only emit stage.start via CMBR-1 resume path; iter>0 guard must not fire unconditionally on fresh runs)" \
+    "0" "$_s12_cycled_starts"
+
 # ── FRSH-2: fresh run with prior state branch artifacts never skips via dispatch-unit guard ─
 print_test_section "[#1805/FRSH-2] fresh run (no --resume, in_progress status) never skips stages due to prior-run artifacts in git state branch"
 
@@ -855,12 +891,6 @@ assert_eq \
     "[#1805/FRSH-2] fresh run emits no stage.skip events (dispatch-unit skip guard conditional on resume_mode; does not activate for fresh runs)" \
     "0" "$_frsh2_stage_skips"
 
-# Together the two assertions — intake dispatches and no stage.skip —
-# fully cover the FRSH-2 requirement. The intake assertion proves the
-# dispatch-unit skip guard is conditional on resume_mode (a guard that
-# activated unconditionally would read prior artifacts and skip intake).
-# The stage.skip assertion proves no stage was skipped due to prior state.
-
 # ── CYCL-1: test uses a fixture containing a cyclic stage ────────────────────
 print_test_section "resume-rehydrate test uses a fixture containing a cyclic stage"
 
