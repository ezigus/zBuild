+# ─── SPEC-7: ZBUILD_STAGE_INPUTS lookup for review_report ────────────────────
+print_test_section "SPEC-7: review_report resolved from ZBUILD_STAGE_INPUTS"
+
+_sf_s7="$(_setup_state spec7 yes no)"
+_art_s7="$(dirname "$_sf_s7")/artifacts"
