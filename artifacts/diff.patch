diff --git a/plugins/agent/security-lens/plugin.sh b/plugins/agent/security-lens/plugin.sh
index a997fb51..b10e2214 100644
--- a/plugins/agent/security-lens/plugin.sh
+++ b/plugins/agent/security-lens/plugin.sh
@@ -67,12 +67,12 @@ _security_lens_write_result() {
             plugin_id: "security-lens",
             generated_at: $ts,
             findings: $findings,
-            stub: false,
+            stub: "false",
             data: {
                 plugin_id: "security-lens",
                 generated_at: $ts,
                 findings: $findings,
-                stub: false
+                stub: "false"
             }
         }' | atomic_write "$output"
 }
@@ -146,7 +146,18 @@ _security_lens_run_inner() {
     # Without the JSON envelope + .result extraction, reasoning turns leak
