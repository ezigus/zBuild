diff --git a/core/pipeline/cycle-orchestrator.sh b/core/pipeline/cycle-orchestrator.sh
index 1e130186..b653ca22 100644
--- a/core/pipeline/cycle-orchestrator.sh
+++ b/core/pipeline/cycle-orchestrator.sh
@@ -1333,7 +1333,7 @@ _CYCLE_VERIFIED_BLOB=""
 # with _CYCLE_ITER_OUTCOME naming why: failed | interrupted | aborted | error
 # (#1850, ADR-054 §4 — the word, never an rc).
 _cycle_iter_dispatch() {
-    local iter="$1" state_file="$2"
+    local iter="$1" state_file="$2" _resume_first_iter="${3:-false}"
     _CYCLE_LAST_VERDICTS_BLOB="{}"
     _CYCLE_LAST_FAILURE_COUNT=0
     _CYCLE_ITER_OUTCOME="error"
@@ -1437,6 +1437,16 @@ _cycle_iter_dispatch() {
                 "$(jq -r '.status // "complete"' <<< "$_ru_entry")" "$(jq -r '.verdict // "pass"' <<< "$_ru_entry")" || true
             continue
         fi
+        # ADR-006 §3.6 / #1805 (CMBR-1): on the first resumed iteration, skip members
+        # already complete in persisted state so dispatch begins at the interrupted member.
+        if [[ "$_resume_first_iter" == "true" ]]; then
+            local _cmbr_status
+            _cmbr_status="$(jq -r --arg s "$s" '.stage_statuses[$s] // "pending"' \
+                "$state_file" 2>/dev/null || echo "pending")"
+            if [[ "$_cmbr_status" == "complete" ]]; then
+                continue
+            fi
+        fi
         _cycle_emit_member_dispatch_start "$_cyc_pos" "$s" "$_member_kind_pre"
         export ZBUILD_CYCLE_ITER="$iter"
         export ZBUILD_CYCLE_ID="${_CYCLE_TRAP_CYCLE_ID}"
@@ -2410,8 +2420,14 @@ _cycle_orchestrator_run_body() {
         fi
 
         # Dispatch the cycle's stages in order.
+        # CMBR-1 (#1805): signal resume_first_iter only for the first resumed iteration
+        # so _cycle_iter_dispatch skips members already complete in persisted state.
+        local _cid_resume_first_iter=false
+        if [[ "$iter" -eq "$_start_iter" && "$_start_iter" -gt 1 ]]; then
+            _cid_resume_first_iter=true
+        fi
         set +e
-        _cycle_iter_dispatch "$iter" "$state_file"
+        _cycle_iter_dispatch "$iter" "$state_file" "$_cid_resume_first_iter"
         local _iter_rc=$?
         [[ $_ORCH_HAD_E -eq 1 ]] && set -e
         # The round stopped before every member ran (#1850: the word, not an rc).
diff --git a/core/pipeline/runner.sh b/core/pipeline/runner.sh
index eb58e9ed..696ff0ff 100755
--- a/core/pipeline/runner.sh
+++ b/core/pipeline/runner.sh
@@ -2212,12 +2212,21 @@ main() {
             auto_resume)
                 info "Auto-resuming previous run via latest symlink (use --no-resume to force fresh start)"
                 # Resolve the per-run dir so artifact operations use the concrete path.
-                state_dir="$(readlink -f "$state_dir/latest")"
-                state_file="$state_dir/pipeline-state.json"
-                _runner_state_file="$state_file"
-                resume_mode=true
-                _runner_run_id="$(get_state_field "$state_file" '.run_id' "$(date +%Y%m%d%H%M%S)-$$")"
-                _runner_issue="$(get_state_field "$state_file" '.issue' '0')"
+                # Guard against broken symlink or missing readlink -f (macOS without GNU coreutils):
+                # an empty result would route all artifact operations to paths under an empty prefix.
+                local _lr_resolved_dir
+                _lr_resolved_dir="$(readlink -f "$state_dir/latest")" || true
+                if [[ -z "$_lr_resolved_dir" ]]; then
+                    warn "auto-resume: could not resolve latest symlink — falling back to fresh start"
+                    resume_mode=false
+                else
+                    state_dir="$_lr_resolved_dir"
+                    state_file="$state_dir/pipeline-state.json"
+                    _runner_state_file="$state_file"
+                    resume_mode=true
+                    _runner_run_id="$(get_state_field "$state_file" '.run_id' "$(date +%Y%m%d%H%M%S)-$$")"
+                    _runner_issue="$(get_state_field "$state_file" '.issue' '0')"
+                fi
                 ;;
             manual_resume_only)
                 info "Previous run requires explicit --resume (or --force for aborted)"
diff --git a/tests/integration/resume-loop-state-test.sh b/tests/integration/resume-loop-state-test.sh
index 486c252f..c050e4b8 100644
--- a/tests/integration/resume-loop-state-test.sh
+++ b/tests/integration/resume-loop-state-test.sh
@@ -192,6 +192,83 @@ assert_eq \
     "[#1805/ITER-1] without _ZBUILD_RESUME_ACTIVE, fresh run starts at iter=1 (guard prevents iter-skip)" \
     "1" "$_SPEC7_FRESH_FIRST_ITER"
 
+# ── [#1805/CMBR-1] cycle member stages already complete in iter k are skipped ─
+# On resume, within the interrupted iteration, cycle member stages already marked
+# complete in persisted state are skipped; the first dispatched cycle member is
+# the interrupted stage.
+print_test_section "[#1805/CMBR-1] complete cycle members in interrupted iter skipped; interrupted member dispatched"
+
+# Given — a run is being resumed; in the interrupted iteration (iter 2), member
+#   stage "build" completed and member stage "test" was interrupted before
+#   completing; persisted state records build as complete within iter 2.
+#   _ZBUILD_RESUME_ACTIVE=true is exported.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+
+# Use zb_engine_loop_state to write cycle state: 2 rounds (iter 1 finished,
+# iter 2 in_progress = current interrupted iter). After this call,
+# cycle_iterations["build-test"].current_iter = 2.
+zb_engine_loop_state "$STATE_FILE" "build-test" 2 5 "in_progress"
+
+# Record that "build" completed in iter 2 before the interruption.
+# stage_statuses.build = "complete" is the standard field the cycle orchestrator
+# checks to decide whether to skip a member on resume (ADR-006 §3.6 / CMBR-1).
+# Use jq to merge this into the existing state; the cycle_iterations block
+# written by zb_engine_loop_state is preserved (`.` merge keeps all other fields).
+jq '.stage_statuses.build = "complete"' "$STATE_FILE" \
+    > "${STATE_FILE}.cmbr1.tmp" && mv "${STATE_FILE}.cmbr1.tmp" "$STATE_FILE"
+
+# Load the template: cycle-converges-iter2.yaml has build + test as cycle members,
+# matching the state above.
+load_template "$FIXT/cycle-converges-iter2.yaml"
+
+# Track which cycle members are dispatched. cycle_dispatch_stage is what causes
+# stage.start events in a unit-test context; not being called for "build" is
+# functionally equivalent to no stage.start for build.
+_CMBR1_BUILD_DISPATCHED=0
+_CMBR1_TEST_DISPATCHED=0
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$stage" == "build" ]]; then
+        _CMBR1_BUILD_DISPATCHED=1
+    elif [[ "$stage" == "test" ]]; then
+        _CMBR1_TEST_DISPATCHED=1
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+zb_stub_reports_tests test
+
+# When — _ZBUILD_RESUME_ACTIVE=true is exported and the cycle orchestrator
+#   dispatches members of iter k (iter 2). "build" is complete; "test" is pending.
+set +e
+export _ZBUILD_RESUME_ACTIVE=true
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_cmbr1_rc=$?
+set -e
+
+# Then — no stage.start event for "build" (already complete in iter k):
+# cycle_dispatch_stage must NOT be called for "build" in iter 2.
+# Before the change: orchestrator does not check member state on resume →
+#   dispatches build regardless → _CMBR1_BUILD_DISPATCHED=1 → assert 0==1 → FAILS.
+# After the change: orchestrator sees stage_statuses.build=complete in iter 2 →
+#   skips build → _CMBR1_BUILD_DISPATCHED=0 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] no stage.start for 'build' in iter 2 (complete member skipped on resume within interrupted iter)" \
+    "0" "$_CMBR1_BUILD_DISPATCHED"
+
+# Then — stage.start is emitted for "test" (the interrupted member of iter k):
+# cycle_dispatch_stage must be called for "test" in iter 2.
+# Before the change: if orchestrator skips ALL members or aborts, test never
+#   dispatches → _CMBR1_TEST_DISPATCHED=0 → assert 1==0 → FAILS.
+# After the change: orchestrator skips build, dispatches test →
+#   _CMBR1_TEST_DISPATCHED=1 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] stage.start emitted for 'test' in iter 2 (interrupted cycle member dispatched on resume)" \
+    "1" "$_CMBR1_TEST_DISPATCHED"
+
 # ── CYCL-1: test uses a fixture containing a cyclic stage ────────────────────
 print_test_section "resume-loop-state test uses a fixture containing a cyclic stage"
 
diff --git a/tests/integration/resume-rehydrate-test.sh b/tests/integration/resume-rehydrate-test.sh
index 7c9f00cb..ab27fe18 100644
--- a/tests/integration/resume-rehydrate-test.sh
+++ b/tests/integration/resume-rehydrate-test.sh
@@ -855,14 +855,11 @@ assert_eq \
     "[#1805/FRSH-2] fresh run emits no stage.skip events (dispatch-unit skip guard conditional on resume_mode; does not activate for fresh runs)" \
     "0" "$_frsh2_stage_skips"
 
-# [#1805/FRSH-2]: The two assertions above — intake dispatches and no stage.skip —
-# fully cover the FRSH-2 requirement. The requirement is that the dispatch-unit
-# skip guard does not activate for fresh runs. The skip guard would suppress a
-# stage.start for a dispatch-unit stage (intake or cyc) if it were unconditionally
-# active. The intake assertion (1) proves the guard did not suppress intake; the
-# no-stage.skip assertion (2) proves the guard did not emit a skip event for any
-# stage. Together they establish that the skip guard is conditional on resume_mode
-# and did not fire on this fresh run, which is the entirety of FRSH-2.
+# Together the two assertions — intake dispatches and no stage.skip —
+# fully cover the FRSH-2 requirement. The intake assertion proves the
+# dispatch-unit skip guard is conditional on resume_mode (a guard that
+# activated unconditionally would read prior artifacts and skip intake).
+# The stage.skip assertion proves no stage was skipped due to prior state.
 
 # ── CYCL-1: test uses a fixture containing a cyclic stage ────────────────────
 print_test_section "resume-rehydrate test uses a fixture containing a cyclic stage"
