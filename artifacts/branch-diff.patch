diff --git a/tests/integration/resume-entry-points-test.sh b/tests/integration/resume-entry-points-test.sh
new file mode 100644
index 00000000..82042af4
--- /dev/null
+++ b/tests/integration/resume-entry-points-test.sh
@@ -0,0 +1,554 @@
+#!/usr/bin/env bash
+# Tests: all three resume entry paths invoke _runner_resume_rehydrate before
+# the dispatch loop. (issue #1805, ADR-006 §3.5)
+#
+# ENTR-1 [code]: All three resume entry paths (--resume flag to runner.sh,
+#   auto-resume on detecting status=interrupted, zbuild pipeline resume
+#   --run-id) invoke _runner_resume_rehydrate before the dispatch loop.
+#   Its test must FAIL on the code as it was before this change.
+#
+# Three sub-tests, each with a separate work repo, state dir, and events dir:
+#   Path 1 — bash runner.sh --resume
+#   Path 2 — bash runner.sh (no --resume; state status=interrupted → auto_resume)
+#   Path 3 — bash zbuild pipeline resume --run-id
+#
+# Discriminating assertion for all paths: intake-result.json is present in
+# ZBUILD_ARTIFACT_DIR after the runner call (artifact restored from state branch).
+# Before this change: no rehydration → artifact absent → FAILS.
+# After this change: _runner_resume_rehydrate restores it → PASSES.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+RUNNER="$REPO_ROOT/core/pipeline/runner.sh"
+ZBUILD_CLI="$REPO_ROOT/scripts/zbuild"
+
+# shellcheck source=../../scripts/lib/helpers.sh
+source "$REPO_ROOT/scripts/lib/helpers.sh"
+# shellcheck source=../../scripts/lib/test-helpers.sh
+source "$REPO_ROOT/scripts/lib/test-helpers.sh"
+# shellcheck source=../../core/state/artifact-persist.sh
+source "$REPO_ROOT/core/state/artifact-persist.sh"
+
+print_test_header "resume-entry-points — all resume paths rehydrate artifacts (#1805)"
+setup_test_env "resume-entry-points-1805"
+export ZBUILD_CONTRACT_VALIDATOR=warn
+
+# Common mock plugins for all three paths.
+mock_plugin_factory "intake" "agent" 0 >/dev/null
+mock_plugin_factory "build"  "agent" 0 >/dev/null
+# cycled sub-stage used by the artifact-snapshot-coverage cyclic fixture (SPEC-13 sub-case).
+mock_plugin_factory "cycled" "agent" 0 "" "builder" >/dev/null
+PLUGINS_ROOT="$TEST_TEMP_DIR/plugins"
+
+# ── Shared helper: set up a work repo with a state branch for one path ──────────
+# Usage: _setup_path_state <label> <issue_id> <run_id> → sets:
+#   P_WORK_REPO, P_STATE_DIR, P_STATE_FILE, P_EVENTS_DIR, P_EVENTS_JSONL
+#   State is at <TEST_TEMP_DIR>/<label>-state-root/runs/<run_id>/ (per ENTR-1 Given).
+_setup_path_state() {
+    local label="$1" issue_id="$2" run_id="$3"
+
+    P_WORK_REPO="$(setup_git_temp_repo "ep-${label}")"
+    install_template_overlay "$P_WORK_REPO" artifact-snapshot-coverage
+
+    # State layout: per-run path <state-root>/runs/<run_id>/ (ENTR-1 Given:
+    # "state is persisted in runs/<run_id>/").
+    local _P_STATE_ROOT="$TEST_TEMP_DIR/${label}-state-root"
+    P_STATE_DIR="$_P_STATE_ROOT/runs/$run_id"
+    P_EVENTS_DIR="$TEST_TEMP_DIR/${label}-events"
+    P_STATE_FILE="$P_STATE_DIR/pipeline-state.json"
+    P_EVENTS_JSONL="$P_EVENTS_DIR/events.jsonl"
+    mkdir -p "$P_STATE_DIR/artifacts" "$P_EVENTS_DIR"
+
+    # Write the intake artifact so the snapshot captures it.
+    printf '{"result_contract":3,"outcome":"pass","reason":"prior-run intake"}' \
+        > "$P_STATE_DIR/artifacts/intake-result.json"
+
+    # Snapshot onto the state branch.
+    local _snap_rc=0
+    ( export ZBUILD_STATE_DIR="$P_STATE_DIR"
+      cd "$P_WORK_REPO" && _artifact_persist_snapshot "$P_STATE_DIR" "$issue_id" ) \
+        >"$TEST_TEMP_DIR/${label}-snap.log" 2>&1 || _snap_rc=$?
+    if [[ "$_snap_rc" -ne 0 ]]; then
+        assert_fail "setup-${label}: snapshot to state branch failed" \
+            "rc=$_snap_rc; $(cat "$TEST_TEMP_DIR/${label}-snap.log" 2>/dev/null | tail -5)"
+    fi
+
+    # Remove artifact from disk; it now lives only on the state branch.
+    rm -f "$P_STATE_DIR/artifacts/intake-result.json"
+}
+
+# ── PATH 1: --resume flag to runner.sh ────────────────────────────────────────
+print_test_section "[#1805/ENTR-1] path 1: bash runner.sh --resume restores artifacts"
+
+# Given — a run has been interrupted; stage intake is marked complete with its artifact
+#   present in the git state branch; run state is persisted in runs/<run_id>/ per ENTR-1.
+P1_ID="$(zb_test_issue)"
+P1_RUN_ID="s9-p1-resume-1805"
+_setup_path_state "p1" "$P1_ID" "$P1_RUN_ID"
+P1_WORK_REPO="$P_WORK_REPO"
+P1_STATE_DIR="$P_STATE_DIR"
+P1_STATE_FILE="$P_STATE_FILE"
+P1_EVENTS_DIR="$P_EVENTS_DIR"
+P1_EVENTS_JSONL="$P_EVENTS_JSONL"
+
+jq -n \
+    --arg run_id "$P1_RUN_ID" \
+    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+    --argjson issue "$P1_ID" \
+    '{
+        schema_version: 1,
+        run_id: $run_id,
+        issue: $issue,
+        stage_statuses: {intake: "complete", cyc: "pending"},
+        current_iteration: 0,
+        self_heal_count: {},
+        scope_manifest_hash: "",
+        cost_ledger_pointer: 0,
+        claim_lease_id: "",
+        plugin_state: {},
+        status: "in_progress",
+        updated_at: $now
+    }' > "$P1_STATE_FILE"
+
+# When — the run is resumed via the --resume flag entry path.
+set +e
+( cd "$P1_WORK_REPO" && env \
+    ZBUILD_CYCLES_ENABLED=1 \
+    ZBUILD_PLUGINS_ROOT="$PLUGINS_ROOT" \
+    ZBUILD_STATE_DIR="$P1_STATE_DIR" \
+    ZBUILD_STATE_FILE="$P1_STATE_FILE" \
+    ZBUILD_EVENTS_DIR="$P1_EVENTS_DIR" \
+    ZBUILD_EVENTS_JSONL="$P1_EVENTS_JSONL" \
+    ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json" \
+    ZBUILD_CONTRACT_VALIDATOR=warn \
+    ZBUILD_VISION_GATE=off \
+    PATH="$PATH" HOME="$HOME" \
+    bash "$RUNNER" --template artifact-snapshot-coverage \
+        --resume --issue "$P1_ID" ) \
+    >"$TEST_TEMP_DIR/p1-stdout.txt" 2>"$TEST_TEMP_DIR/p1-stderr.txt"
+set -e
+
+# Then — completed-stage artifacts appear in ZBUILD_ARTIFACT_DIR before any stage.start event.
+# [#1805/ENTR-1] path 1: artifact restored.
+# Before change: no rehydration → file absent → FAILS.
+# After change: _runner_resume_rehydrate restores it → PASSES.
+assert_file_exists \
+    "[#1805/ENTR-1] path 1 (--resume flag): intake-result.json restored from state branch" \
+    "$P1_STATE_DIR/artifacts/intake-result.json"
+
+# [#1805/ENTR-1] path 1: pipeline.resume event must be emitted BEFORE the first
+# stage.start. The runner emits pipeline.resume immediately after
+# _runner_resume_rehydrate returns, before entering the dispatch loop. A
+# pipeline.resume line number lower than the first stage.start line number
+# proves the rehydration call completed before any stage was dispatched.
+# Before change: no _runner_resume_rehydrate → no pipeline.resume event →
+#   resume_lineno=0 → assert 0 > 0 → FAILS.
+# After change: _runner_resume_rehydrate called → pipeline.resume emitted before
+#   dispatch loop → resume_lineno > 0 and < first_start_lineno → PASSES.
+_p1_resume_lineno=0
+_p1_first_start_lineno=0
+if [[ -f "$P1_EVENTS_JSONL" ]]; then
+    _p1_resume_lineno="$(awk '/"pipeline.resume"/{print NR; exit}' "$P1_EVENTS_JSONL" 2>/dev/null)"
+    _p1_resume_lineno="${_p1_resume_lineno:-0}"
+    _p1_first_start_lineno="$(awk '/"stage.start"/{print NR; exit}' "$P1_EVENTS_JSONL" 2>/dev/null)"
+    _p1_first_start_lineno="${_p1_first_start_lineno:-0}"
+fi
+assert_gt "[#1805/ENTR-1] path 1 (--resume flag): pipeline.resume event emitted (rehydration ran before dispatch)" \
+    "$_p1_resume_lineno" "0"
+assert_gt "[#1805/ENTR-1] path 1 (--resume flag): pipeline.resume precedes first stage.start (rehydration before dispatch loop)" \
+    "$_p1_first_start_lineno" "$_p1_resume_lineno"
+
+# [#1805/ENTR-1] path 1: no stage.start event must be emitted for intake (a stage marked
+# complete in the interrupted run's state). The runner skips complete stages on resume;
+# only the interrupted stage (build) may emit stage.start.
+# Before change: resume doesn't skip complete stages → intake dispatched → intake_starts=1 →
+#   assert 0==1 → FAILS.
+# After change: _runner_resume_rehydrate marks intake complete/rehydrated → dispatch loop
+#   skips it → intake_starts=0 → PASSES.
+_p1_intake_starts=0
+if [[ -f "$P1_EVENTS_JSONL" ]]; then
+    _p1_intake_starts="$(jq -r 'select(.type=="stage.start" and .data.stage=="intake") | .type' \
+        "$P1_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+fi
+assert_eq "[#1805/ENTR-1] path 1 (--resume flag): no stage.start for intake (complete stage skipped before dispatch loop)" \
+    "0" "$_p1_intake_starts"
+
+# ── PATH 2: auto-resume on detecting status=interrupted ───────────────────────
+print_test_section "[#1805/ENTR-1] path 2: auto-resume on status=interrupted restores artifacts"
+
+# Given — a run has been interrupted (status=interrupted); stage intake is marked
+#   complete with its artifact present in the git state branch; run state is persisted
+#   in runs/<run_id>/ per ENTR-1.
+P2_ID="$(zb_test_issue)"
+P2_RUN_ID="s9-p2-resume-1805"
+_setup_path_state "p2" "$P2_ID" "$P2_RUN_ID"
+P2_WORK_REPO="$P_WORK_REPO"
+P2_STATE_DIR="$P_STATE_DIR"
+P2_STATE_FILE="$P_STATE_FILE"
+P2_EVENTS_DIR="$P_EVENTS_DIR"
+P2_EVENTS_JSONL="$P_EVENTS_JSONL"
+
+# status=interrupted → get_resume_recommendation → auto_resume → resume_mode=true.
+jq -n \
+    --arg run_id "$P2_RUN_ID" \
+    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+    --argjson issue "$P2_ID" \
+    '{
+        schema_version: 1,
+        run_id: $run_id,
+        issue: $issue,
+        stage_statuses: {intake: "complete", cyc: "pending"},
+        current_iteration: 0,
+        self_heal_count: {},
+        scope_manifest_hash: "",
+        cost_ledger_pointer: 0,
+        claim_lease_id: "",
+        plugin_state: {},
+        status: "interrupted",
+        updated_at: $now
+    }' > "$P2_STATE_FILE"
+
+# When — the run is resumed via the auto-resume entry path (no --resume flag;
+#   runner detects status=interrupted and auto-resumes).
+set +e
+( cd "$P2_WORK_REPO" && env \
+    ZBUILD_CYCLES_ENABLED=1 \
+    ZBUILD_PLUGINS_ROOT="$PLUGINS_ROOT" \
+    ZBUILD_STATE_DIR="$P2_STATE_DIR" \
+    ZBUILD_STATE_FILE="$P2_STATE_FILE" \
+    ZBUILD_EVENTS_DIR="$P2_EVENTS_DIR" \
+    ZBUILD_EVENTS_JSONL="$P2_EVENTS_JSONL" \
+    ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json" \
+    ZBUILD_CONTRACT_VALIDATOR=warn \
+    ZBUILD_VISION_GATE=off \
+    PATH="$PATH" HOME="$HOME" \
+    bash "$RUNNER" --template artifact-snapshot-coverage ) \
+    >"$TEST_TEMP_DIR/p2-stdout.txt" 2>"$TEST_TEMP_DIR/p2-stderr.txt"
+set -e
+
+# Then — completed-stage artifacts appear in ZBUILD_ARTIFACT_DIR before any stage.start event.
+# [#1805/ENTR-1] path 2: artifact restored via auto-resume.
+# Before change: no rehydration → file absent → FAILS.
+# After change: auto-resume path invokes _runner_resume_rehydrate → PASSES.
+assert_file_exists \
+    "[#1805/ENTR-1] path 2 (auto-resume/interrupted): intake-result.json restored from state branch" \
+    "$P2_STATE_DIR/artifacts/intake-result.json"
+
+# [#1805/ENTR-1] path 2: pipeline.resume event emitted before first stage.start,
+# proving _runner_resume_rehydrate was called before the dispatch loop.
+# Before change: no _runner_resume_rehydrate → pipeline.resume absent →
+#   resume_lineno=0 → assert 0 > 0 → FAILS.
+# After change: auto-resume path calls _runner_resume_rehydrate →
+#   pipeline.resume emitted before dispatch loop → PASSES.
+_p2_resume_lineno=0
+_p2_first_start_lineno=0
+if [[ -f "$P2_EVENTS_JSONL" ]]; then
+    _p2_resume_lineno="$(awk '/"pipeline.resume"/{print NR; exit}' "$P2_EVENTS_JSONL" 2>/dev/null)"
+    _p2_resume_lineno="${_p2_resume_lineno:-0}"
+    _p2_first_start_lineno="$(awk '/"stage.start"/{print NR; exit}' "$P2_EVENTS_JSONL" 2>/dev/null)"
+    _p2_first_start_lineno="${_p2_first_start_lineno:-0}"
+fi
+assert_gt "[#1805/ENTR-1] path 2 (auto-resume): pipeline.resume event emitted (rehydration ran before dispatch)" \
+    "$_p2_resume_lineno" "0"
+assert_gt "[#1805/ENTR-1] path 2 (auto-resume): pipeline.resume precedes first stage.start (rehydration before dispatch loop)" \
+    "$_p2_first_start_lineno" "$_p2_resume_lineno"
+
+# [#1805/ENTR-1] path 2: no stage.start event must be emitted for intake (a stage
+# marked complete in the interrupted run's state). Complete stages are skipped on resume.
+# Before change: resume doesn't skip complete stages → intake dispatched →
+#   intake_starts=1 → assert 0==1 → FAILS.
+# After change: dispatch loop skips intake → intake_starts=0 → PASSES.
+_p2_intake_starts=0
+if [[ -f "$P2_EVENTS_JSONL" ]]; then
+    _p2_intake_starts="$(jq -r 'select(.type=="stage.start" and .data.stage=="intake") | .type' \
+        "$P2_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+fi
+assert_eq "[#1805/ENTR-1] path 2 (auto-resume): no stage.start for intake (complete stage skipped before dispatch loop)" \
+    "0" "$_p2_intake_starts"
+
+# ── PATH 3: zbuild pipeline resume --run-id ───────────────────────────────────
+print_test_section "[#1805/ENTR-1] path 3: zbuild pipeline resume --run-id restores artifacts"
+
+# Given — a run has been interrupted (status=interrupted); stage intake is marked
+#   complete with its artifact present in the git state branch; run state persisted
+#   with a known run_id in runs/<run_id>/ per ENTR-1.
+P3_ID="$(zb_test_issue)"
+P3_RUN_ID="s9-p3-resume-1805"
+_setup_path_state "p3" "$P3_ID" "$P3_RUN_ID"
+P3_WORK_REPO="$P_WORK_REPO"
+P3_STATE_DIR="$P_STATE_DIR"
+P3_STATE_FILE="$P_STATE_FILE"
+P3_EVENTS_DIR="$P_EVENTS_DIR"
+P3_EVENTS_JSONL="$P_EVENTS_JSONL"
+
+# status=interrupted so zbuild doesn't refuse (aborted requires --force;
+# interrupted is accepted). zbuild changes it to in_progress, then runner sees --resume.
+jq -n \
+    --arg run_id "$P3_RUN_ID" \
+    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+    --argjson issue "$P3_ID" \
+    '{
+        schema_version: 1,
+        run_id: $run_id,
+        issue: $issue,
+        stage_statuses: {intake: "complete", cyc: "pending"},
+        current_iteration: 0,
+        self_heal_count: {},
+        scope_manifest_hash: "",
+        cost_ledger_pointer: 0,
+        claim_lease_id: "",
+        plugin_state: {},
+        status: "interrupted",
+        updated_at: $now
+    }' > "$P3_STATE_FILE"
+
+# When — the run is resumed via zbuild pipeline resume --run-id entry path.
+# zbuild pipeline resume reads ZBUILD_STATE_DIR and finds the state file by run_id.
+# It sets status=in_progress and calls runner with --resume.
+# The runner's CWD must be P3_WORK_REPO so _artifact_persist_restore finds the branch.
+set +e
+( cd "$P3_WORK_REPO" && env \
+    ZBUILD_CYCLES_ENABLED=1 \
+    ZBUILD_PLUGINS_ROOT="$PLUGINS_ROOT" \
+    ZBUILD_STATE_DIR="$P3_STATE_DIR" \
+    ZBUILD_EVENTS_DIR="$P3_EVENTS_DIR" \
+    ZBUILD_EVENTS_JSONL="$P3_EVENTS_JSONL" \
+    ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json" \
+    ZBUILD_CONTRACT_VALIDATOR=warn \
+    ZBUILD_VISION_GATE=off \
+    PATH="$PATH" HOME="$HOME" \
+    bash "$ZBUILD_CLI" pipeline resume \
+        --run-id "$P3_RUN_ID" \
+        --template artifact-snapshot-coverage ) \
+    >"$TEST_TEMP_DIR/p3-stdout.txt" 2>"$TEST_TEMP_DIR/p3-stderr.txt"
+set -e
+
+# Then — completed-stage artifacts appear in ZBUILD_ARTIFACT_DIR before any stage.start event.
+# [#1805/ENTR-1] path 3: artifact restored via zbuild pipeline resume.
+# Before change: no rehydration → file absent → FAILS.
+# After change: zbuild pipeline resume → runner --resume → _runner_resume_rehydrate → PASSES.
+assert_file_exists \
+    "[#1805/ENTR-1] path 3 (zbuild pipeline resume): intake-result.json restored from state branch" \
+    "$P3_STATE_DIR/artifacts/intake-result.json"
+
+# [#1805/ENTR-1] path 3: pipeline.resume event emitted before first stage.start,
+# proving zbuild pipeline resume invokes _runner_resume_rehydrate before the
+# dispatch loop.
+# Before change: no _runner_resume_rehydrate → pipeline.resume absent →
+#   resume_lineno=0 → assert 0 > 0 → FAILS.
+# After change: zbuild calls runner --resume → _runner_resume_rehydrate called →
+#   pipeline.resume emitted before dispatch loop → PASSES.
+_p3_resume_lineno=0
+_p3_first_start_lineno=0
+if [[ -f "$P3_EVENTS_JSONL" ]]; then
+    _p3_resume_lineno="$(awk '/"pipeline.resume"/{print NR; exit}' "$P3_EVENTS_JSONL" 2>/dev/null)"
+    _p3_resume_lineno="${_p3_resume_lineno:-0}"
+    _p3_first_start_lineno="$(awk '/"stage.start"/{print NR; exit}' "$P3_EVENTS_JSONL" 2>/dev/null)"
+    _p3_first_start_lineno="${_p3_first_start_lineno:-0}"
+fi
+assert_gt "[#1805/ENTR-1] path 3 (zbuild pipeline resume): pipeline.resume event emitted (rehydration ran before dispatch)" \
+    "$_p3_resume_lineno" "0"
+assert_gt "[#1805/ENTR-1] path 3 (zbuild pipeline resume): pipeline.resume precedes first stage.start (rehydration before dispatch loop)" \
+    "$_p3_first_start_lineno" "$_p3_resume_lineno"
+
+# [#1805/ENTR-1] path 3: no stage.start event must be emitted for intake (a stage
+# marked complete in the interrupted run's state). Complete stages are skipped on resume.
+# Before change: resume doesn't skip complete stages → intake dispatched →
+#   intake_starts=1 → assert 0==1 → FAILS.
+# After change: dispatch loop skips intake → intake_starts=0 → PASSES.
+_p3_intake_starts=0
+if [[ -f "$P3_EVENTS_JSONL" ]]; then
+    _p3_intake_starts="$(jq -r 'select(.type=="stage.start" and .data.stage=="intake") | .type' \
+        "$P3_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+fi
+assert_eq "[#1805/ENTR-1] path 3 (zbuild pipeline resume): no stage.start for intake (complete stage skipped before dispatch loop)" \
+    "0" "$_p3_intake_starts"
+
+# ── SPEC-13: test uses a fixture containing a cyclic stage ────────────────────
+print_test_section "resume-entry-points test uses a fixture containing a cyclic stage"
+
+# Run a fresh pipeline against the cyclic fixture (artifact-snapshot-coverage) to
+# demonstrate that this test file exercises a pipeline containing a cyclic stage.
+_S13_EP_ID="$(zb_test_issue)"
+_S13_EP_WORK="$(setup_git_temp_repo ep-s13-cycle-check)"
+install_template_overlay "$_S13_EP_WORK" artifact-snapshot-coverage
+
+_S13_EP_STATE_DIR="$TEST_TEMP_DIR/s13ep-state"
+_S13_EP_EVENTS_DIR="$TEST_TEMP_DIR/s13ep-events"
+_S13_EP_EVENTS_JSONL="$_S13_EP_EVENTS_DIR/events.jsonl"
+_S13_EP_STATE_FILE="$_S13_EP_STATE_DIR/pipeline-state.json"
+mkdir -p "$_S13_EP_STATE_DIR/artifacts" "$_S13_EP_EVENTS_DIR"
+
+jq -n \
+    --arg run_id "s13ep-fresh-1805" \
+    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+    --argjson issue "$_S13_EP_ID" \
+    '{
+        schema_version: 1, run_id: $run_id, issue: $issue,
+        stage_statuses: {}, current_iteration: 0, self_heal_count: {},
+        scope_manifest_hash: "", cost_ledger_pointer: 0, claim_lease_id: "",
+        plugin_state: {}, status: "in_progress", updated_at: $now
+    }' > "$_S13_EP_STATE_FILE"
+
+set +e
+( cd "$_S13_EP_WORK" && env \
+    ZBUILD_PLUGINS_ROOT="$PLUGINS_ROOT" \
+    ZBUILD_STATE_DIR="$_S13_EP_STATE_DIR" \
+    ZBUILD_STATE_FILE="$_S13_EP_STATE_FILE" \
+    ZBUILD_EVENTS_DIR="$_S13_EP_EVENTS_DIR" \
+    ZBUILD_EVENTS_JSONL="$_S13_EP_EVENTS_JSONL" \
+    ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json" \
+    ZBUILD_CONTRACT_VALIDATOR=warn \
+    ZBUILD_VISION_GATE=off \
+    ZBUILD_CYCLES_ENABLED=1 \
+    PATH="$PATH" HOME="$HOME" \
+    bash "$RUNNER" --template artifact-snapshot-coverage --issue "$_S13_EP_ID" ) \
+    >"$TEST_TEMP_DIR/s13ep-stdout.txt" 2>"$TEST_TEMP_DIR/s13ep-stderr.txt"
+set -e
+
+# : the fixture is cyclic (type: cycle present).
+_s13_ep_content="$(cat "$REPO_ROOT/tests/fixtures/templates/artifact-snapshot-coverage.yaml")"
+assert_contains "resume-entry-points test uses a cyclic fixture (type: cycle)" \
+    "$_s13_ep_content" "type: cycle"
+
+# : confirm the cyclic pipeline ran (intake dispatched in the fresh run).
+_s13_ep_intake_starts="$(jq -r 'select(.type=="stage.start" and .data.stage=="intake") | .type' \
+    "$_S13_EP_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+assert_eq "cyclic fixture pipeline ran in resume-entry-points test (intake dispatched)" \
+    "1" "$_s13_ep_intake_starts"
+
+# intake dispatching into a cycle-fixture pipeline is sufficient evidence the pipeline
+# executed (not just a non-cyclic path). The cycled sub-stage dispatch depends on the
+# cycle-orchestrator implementation and is not required by SPEC-9 (artifact restoration).
+
+# ── PATH 4 (ENTR-2): auto-resume via `latest` symlink, no ZBUILD_STATE_FILE ───
+print_test_section "[#1805/ENTR-2] auto-resume via latest symlink (no ZBUILD_STATE_FILE set)"
+
+# Given — a previous run stored state at $ZBUILD_STATE_ROOT/runs/<run_id>/pipeline-state.json
+#   with status=interrupted; $ZBUILD_STATE_ROOT/latest symlinks to that per-run dir;
+#   ZBUILD_STATE_FILE and ZBUILD_STATE_DIR are unset.
+P4_ID="$(zb_test_issue)"
+P4_RUN_ID="e2-p4-resume-1805"
+P4_WORK_REPO="$(setup_git_temp_repo "ep-p4")"
+install_template_overlay "$P4_WORK_REPO" artifact-snapshot-coverage
+
+P4_STATE_ROOT="$TEST_TEMP_DIR/p4-state-root"
+P4_RUN_DIR="$P4_STATE_ROOT/runs/$P4_RUN_ID"
+P4_EVENTS_DIR="$TEST_TEMP_DIR/p4-events"
+P4_EVENTS_JSONL="$P4_EVENTS_DIR/events.jsonl"
+mkdir -p "$P4_RUN_DIR/artifacts" "$P4_EVENTS_DIR"
+
+# Write the intake artifact and snapshot it to the git state branch.
+printf '{"result_contract":3,"outcome":"pass","reason":"prior-run intake entr2"}' \
+    > "$P4_RUN_DIR/artifacts/intake-result.json"
+
+_p4_snap_rc=0
+( export ZBUILD_STATE_DIR="$P4_RUN_DIR"
+  cd "$P4_WORK_REPO" && _artifact_persist_snapshot "$P4_RUN_DIR" "$P4_ID" ) \
+    >"$TEST_TEMP_DIR/p4-snap.log" 2>&1 || _p4_snap_rc=$?
+if [[ "$_p4_snap_rc" -ne 0 ]]; then
+    echo "setup-p4: snapshot to state branch failed (rc=$_p4_snap_rc):" >&2
+    cat "$TEST_TEMP_DIR/p4-snap.log" >&2
+fi
+
+# Remove artifact from disk; it now lives only on the state branch.
+rm -f "$P4_RUN_DIR/artifacts/intake-result.json"
+
+# Create the latest symlink pointing to the per-run state dir.
+ln -sfn "$P4_RUN_DIR" "$P4_STATE_ROOT/latest"
+
+# Write state file at the per-run path with status=interrupted and intake=complete.
+jq -n \
+    --arg run_id "$P4_RUN_ID" \
+    --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+    --argjson issue "$P4_ID" \
+    '{
+        schema_version: 1,
+        run_id: $run_id,
+        issue: $issue,
+        stage_statuses: {intake: "complete", cyc: "pending"},
+        current_iteration: 0,
+        self_heal_count: {},
+        scope_manifest_hash: "",
+        cost_ledger_pointer: 0,
+        claim_lease_id: "",
+        plugin_state: {},
+        status: "interrupted",
+        updated_at: $now
+    }' > "$P4_RUN_DIR/pipeline-state.json"
+
+# When — runner invoked with ZBUILD_STATE_FILE and ZBUILD_STATE_DIR unset;
+#   only ZBUILD_STATE_ROOT is set, pointing to the state root containing the
+#   latest symlink. The runner must find state via $ZBUILD_STATE_ROOT/latest.
+set +e
+( cd "$P4_WORK_REPO" && env -u ZBUILD_STATE_FILE -u ZBUILD_STATE_DIR \
+    ZBUILD_CYCLES_ENABLED=1 \
+    ZBUILD_PLUGINS_ROOT="$PLUGINS_ROOT" \
+    ZBUILD_STATE_ROOT="$P4_STATE_ROOT" \
+    ZBUILD_EVENTS_DIR="$P4_EVENTS_DIR" \
+    ZBUILD_EVENTS_JSONL="$P4_EVENTS_JSONL" \
+    ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json" \
+    ZBUILD_CONTRACT_VALIDATOR=warn \
+    ZBUILD_VISION_GATE=off \
+    PATH="$PATH" HOME="$HOME" \
+    bash "$RUNNER" --template artifact-snapshot-coverage ) \
+    >"$TEST_TEMP_DIR/p4-stdout.txt" 2>"$TEST_TEMP_DIR/p4-stderr.txt"
+set -e
+
+# Then
+# [#1805/ENTR-2]: pipeline.resume event emitted (auto-resume fired via latest symlink).
+# Before change: state_file=$ZBUILD_STATE_ROOT/pipeline-state.json doesn't exist
+#   (state only at runs/<run_id>/) → [[ -f "$state_file" ]] is false → auto-resume
+#   block not entered → pipeline.resume not emitted → resume_lineno=0 →
+#   assert_gt 0 > 0 → FAILS.
+# After change: runner follows latest symlink → finds pipeline-state.json with
+#   status=interrupted → auto-resumes → pipeline.resume emitted → PASSES.
+_p4_resume_lineno=0
+if [[ -f "$P4_EVENTS_JSONL" ]]; then
+    _p4_resume_lineno="$(awk '/"pipeline.resume"/{print NR; exit}' "$P4_EVENTS_JSONL" 2>/dev/null)"
+    _p4_resume_lineno="${_p4_resume_lineno:-0}"
+fi
+assert_gt "[#1805/ENTR-2] auto-resume via latest symlink: pipeline.resume event emitted (resume_mode=true)" \
+    "$_p4_resume_lineno" "0"
+
+# [#1805/ENTR-2]: artifacts were restored BEFORE any stage.start event. The runner emits
+#   pipeline.resume immediately after _runner_resume_rehydrate returns, before the dispatch
+#   loop. A pipeline.resume line number lower than the first stage.start line number proves
+#   the rehydration completed before any stage was dispatched.
+# Before change: auto-resume not triggered → no pipeline.resume → resume_lineno=0 →
+#   the assert_gt resume > 0 above already fails; this assertion adds explicit ordering
+#   evidence that the artifact was placed BEFORE the dispatch loop.
+# After change: auto-resume via latest → pipeline.resume emitted before dispatch →
+#   first_start_lineno > resume_lineno → PASSES.
+_p4_first_start_lineno=0
+if [[ -f "$P4_EVENTS_JSONL" ]]; then
+    _p4_first_start_lineno="$(awk '/"stage.start"/{print NR; exit}' "$P4_EVENTS_JSONL" 2>/dev/null)"
+    _p4_first_start_lineno="${_p4_first_start_lineno:-0}"
+fi
+assert_gt "[#1805/ENTR-2] auto-resume via latest symlink: pipeline.resume precedes first stage.start (artifact restored before dispatch loop)" \
+    "$_p4_first_start_lineno" "$_p4_resume_lineno"
+
+# [#1805/ENTR-2]: completed-stage artifacts restored from the per-run state directory
+#   before any stage.start event is emitted.
+# Before change: auto-resume not triggered → no rehydration call → artifact absent → FAILS.
+# After change: auto-resume via latest → _runner_resume_rehydrate → artifact restored → PASSES.
+assert_file_exists \
+    "[#1805/ENTR-2] auto-resume via latest symlink: intake-result.json restored from per-run state dir" \
+    "$P4_RUN_DIR/artifacts/intake-result.json"
+
+# [#1805/ENTR-2]: no stage.start event for intake (a stage marked complete in the
+#   per-run state file). The dispatch loop must skip it.
+# Before change: no resume_mode → intake dispatched normally → intake_starts=1 → FAILS.
+# After change: resume_mode → dispatch loop skips intake → intake_starts=0 → PASSES.
+_p4_intake_starts=0
+if [[ -f "$P4_EVENTS_JSONL" ]]; then
+    _p4_intake_starts="$(jq -r 'select(.type=="stage.start" and .data.stage=="intake") | .type' \
+        "$P4_EVENTS_JSONL" 2>/dev/null | wc -l | tr -d ' ')"
+fi
+assert_eq "[#1805/ENTR-2] auto-resume via latest symlink: no stage.start for intake (complete stage skipped)" \
+    "0" "$_p4_intake_starts"
+
+cleanup_test_env
+print_test_results
+exit $((FAIL > 0))
diff --git a/tests/integration/resume-loop-state-test.sh b/tests/integration/resume-loop-state-test.sh
new file mode 100644
index 00000000..87ab7c15
--- /dev/null
+++ b/tests/integration/resume-loop-state-test.sh
@@ -0,0 +1,366 @@
+#!/usr/bin/env bash
+# Tests: cycle orchestrator reads persisted current_iter and starts the
+# iteration loop from that value (not 1) on resume. (issue #1805, ADR-006 §3.5)
+#
+# ITER-1 [code]: Cycle orchestrator reads cycle_iterations[CYCLE_ID].current_iter
+#   from persisted state at resume and starts the iteration loop from that value
+#   (not 1); iter-1 complete stages emit no stage.start on resume into iter-2;
+#   the guard uses _ZBUILD_RESUME_ACTIVE so fresh runs and nested-loop re-entries
+#   always start at iter=1. Its test must FAIL before this change.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+FIXT="$REPO_ROOT/tests/fixtures/templates"
+
+# shellcheck source=../../scripts/lib/helpers.sh
+source "$REPO_ROOT/scripts/lib/helpers.sh"
+# shellcheck source=../../scripts/lib/test-helpers.sh
+source "$REPO_ROOT/scripts/lib/test-helpers.sh"
+
+print_test_header "resume-loop-state — cycle orchestrator resumes from persisted iter (#1805)"
+setup_test_env "resume-loop-state-1805"
+
+export ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json"
+export ZBUILD_EVENTS_DIR="$TEST_TEMP_DIR/events"
+export ZBUILD_EVENTS_JSONL="$ZBUILD_EVENTS_DIR/events.jsonl"
+export ZBUILD_STATE_DIR="$TEST_TEMP_DIR/state"
+mkdir -p "$ZBUILD_EVENTS_DIR" "$ZBUILD_STATE_DIR"
+
+# shellcheck source=../../core/pipeline/cycle-orchestrator.sh
+source "$REPO_ROOT/core/pipeline/cycle-orchestrator.sh"
+# shellcheck source=../../core/pipeline/template.sh
+source "$REPO_ROOT/core/pipeline/template.sh"
+# shellcheck source=../lib/cycle-report-stub.sh
+source "$REPO_ROOT/tests/lib/cycle-report-stub.sh"
+
+STATE_FILE="$ZBUILD_STATE_DIR/pipeline-state.json"
+
+# ── [#1805/ITER-1] cycle starts from persisted current_iter on resume ─────────
+print_test_section "[#1805/ITER-1] cycle orchestrator resumes from current_iter (not 1)"
+
+# Given — a resume; persisted state records cycle_iterations[build-test].current_iter=2
+#   (iter 1 completed before interruption); _ZBUILD_RESUME_ACTIVE=true is exported.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+
+# Use zb_engine_loop_state to write current_iter=2 into the state file.
+# This simulates: iter 1 of the cycle completed; the run was interrupted before
+# iter 2 dispatched. After the change the orchestrator reads current_iter=2 and
+# starts from iter 2. Before the change it ignores state and starts from iter 1.
+zb_engine_loop_state "$STATE_FILE" "build-test" 2 5 "in_progress"
+
+# Load the cycle template.
+load_template "$FIXT/cycle-converges-iter2.yaml"
+
+# Mock cycle_dispatch_stage: record the first iter dispatched and whether iter=1
+# was ever dispatched. cycle_dispatch_stage is the entry point for dispatching
+# individual stages inside a cycle iteration; if any iter=1 stage were dispatched
+# it would set _SPEC7_ITER1_DISPATCHED. Not being called for iter=1 is functionally
+# equivalent to no stage.start being emitted for iter-1 stages in a unit-test context
+# (cycle_dispatch_stage is what causes stage.start events to be emitted).
+_SPEC7_FIRST_ITER=-1
+_SPEC7_ITER1_DISPATCHED=0
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$_SPEC7_FIRST_ITER" -eq -1 ]]; then
+        _SPEC7_FIRST_ITER="$iter"
+    fi
+    if [[ "$iter" -eq 1 ]]; then
+        _SPEC7_ITER1_DISPATCHED=1
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+# The report stub makes the test member report zero test failures (pass).
+zb_stub_reports_tests test
+
+# When — _ZBUILD_RESUME_ACTIVE=true is exported and the cycle orchestrator's run
+#   body executes. Before this change: loop starts at iter=1. After: reads
+#   current_iter=2 and starts at iter 2.
+set +e
+export _ZBUILD_RESUME_ACTIVE=true
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_s7_rc=$?
+set -e
+
+# Then — first dispatched iter must be 2, not 1.
+# Before the change: orchestrator ignores current_iter, starts at iter=1 →
+#   _SPEC7_FIRST_ITER=1 → assert 2==1 → FAILS.
+# After the change: reads current_iter=2, starts at iter=2 →
+#   _SPEC7_FIRST_ITER=2 → assert 2==2 → PASSES.
+assert_eq \
+    "[#1805/ITER-1] first dispatched iter is 2 (resumed from current_iter=2, not restarted from 1)" \
+    "2" "$_SPEC7_FIRST_ITER"
+
+# Then — iter-1 stages must not be dispatched on resume into iter-2.
+# cycle_dispatch_stage is never called with iter=1 → _SPEC7_ITER1_DISPATCHED=0 → no
+# stage.start events for iter-1 stages.
+# Before the change: starts at iter=1 → iter-1 stages dispatched →
+#   _SPEC7_ITER1_DISPATCHED=1 → assert 0==1 → FAILS.
+# After the change: starts at iter=2 → iter-1 never dispatched →
+#   _SPEC7_ITER1_DISPATCHED=0 → PASSES.
+assert_eq \
+    "[#1805/ITER-1] iter-1 stages not dispatched on resume into iter-2 (no stage.start for complete iter)" \
+    "0" "$_SPEC7_ITER1_DISPATCHED"
+
+# ── [#1805/ITER-1] clause 2b: nested-loop re-entry starts at iter=1 ──────────
+# A nested-loop re-entry (inner cycle called from within an outer cycle iteration)
+# must start at iter=1, not from current_iter in state.
+# Mechanism: the outer resume path consumes/clears _ZBUILD_RESUME_ACTIVE after using it,
+# so any nested (inner) cycle call that follows sees the flag as cleared and starts at iter=1.
+# This sub-test does NOT manually clear _ZBUILD_RESUME_ACTIVE — it relies on the outer
+# cycle_orchestrator_run call above having consumed/cleared the flag.
+print_test_section "[#1805/ITER-1] nested-loop re-entry after outer resume starts at iter=1 (outer consumed flag)"
+
+# Given — outer resume consumed _ZBUILD_RESUME_ACTIVE; persisted state records
+#   cycle_iterations[build-test].current_iter=2 (same setup as above).
+#   _ZBUILD_RESUME_ACTIVE is NOT manually cleared here — the outer call consumed it.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+zb_engine_loop_state "$STATE_FILE" "build-test" 2 5 "in_progress"
+
+# _ZBUILD_RESUME_ACTIVE is intentionally not set here.
+# We check whatever state the outer cycle_orchestrator_run left the flag in.
+_SPEC7_NESTED_FIRST_ITER=-1
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$_SPEC7_NESTED_FIRST_ITER" -eq -1 ]]; then
+        _SPEC7_NESTED_FIRST_ITER="$iter"
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+# When — cycle_orchestrator_run executes (simulating a nested-loop re-entry after
+#   the outer resume consumed the resume flag).
+set +e
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_s7_nested_rc=$?
+set -e
+
+# Then — nested-loop re-entry starts at iter=1 (outer resume consumed/cleared flag).
+# Correct implementation (clears flag after outer use): starts at iter=1 → PASSES.
+# Incorrect implementation (keeps flag active): starts at iter=2 → FAILS (regression detector).
+# Before this change (no resume logic): always starts at 1 → passes trivially.
+assert_eq \
+    "[#1805/ITER-1] nested-loop re-entry starts at iter=1 (outer resume consumed/cleared _ZBUILD_RESUME_ACTIVE)" \
+    "1" "$_SPEC7_NESTED_FIRST_ITER"
+
+# ── [#1805/ITER-1] clause 3: _ZBUILD_RESUME_ACTIVE guard — fresh runs start at iter=1 ─
+# Without _ZBUILD_RESUME_ACTIVE=true, the orchestrator must start at iter=1 even
+# when current_iter=2 is in state. This verifies the guard prevents the resume-path
+# from affecting fresh runs and nested re-entries.
+print_test_section "[#1805/ITER-1] without _ZBUILD_RESUME_ACTIVE, fresh run always starts at iter=1"
+
+# Given — _ZBUILD_RESUME_ACTIVE is unset (fresh run); persisted state records
+#   cycle_iterations[build-test].current_iter=2. If the guard is absent, new code
+#   would read current_iter=2 and start at iter=2 → assertion fails.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+zb_engine_loop_state "$STATE_FILE" "build-test" 2 5 "in_progress"
+
+# Unset the resume guard: simulates a fresh run (or a nested-loop re-entry).
+unset _ZBUILD_RESUME_ACTIVE
+
+_SPEC7_FRESH_FIRST_ITER=-1
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$_SPEC7_FRESH_FIRST_ITER" -eq -1 ]]; then
+        _SPEC7_FRESH_FIRST_ITER="$iter"
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+# When — cycle_orchestrator_run executes with no resume flag (fresh run).
+set +e
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_s7_fresh_rc=$?
+set -e
+
+# Then — without _ZBUILD_RESUME_ACTIVE, the orchestrator starts at iter=1 even
+# though current_iter=2 is in state. Guard prevents resume-state affecting fresh runs.
+# Old code (no resume logic): always starts at 1 → PASSES (guard trivially holds).
+# New code with guard: unset → bypasses current_iter lookup → starts at 1 → PASSES.
+# New code WITHOUT guard: would start at 2 → FAILS (regression detector).
+assert_eq \
+    "[#1805/ITER-1] without _ZBUILD_RESUME_ACTIVE, fresh run starts at iter=1 (guard prevents iter-skip)" \
+    "1" "$_SPEC7_FRESH_FIRST_ITER"
+
+# ── [#1805/CMBR-1] cycle member stages already complete in iter k are skipped ─
+# On resume, within the interrupted iteration, cycle member stages already marked
+# complete in persisted state are skipped; the first dispatched cycle member is
+# the interrupted stage.
+print_test_section "[#1805/CMBR-1] complete cycle members in interrupted iter skipped; interrupted member dispatched"
+
+# Given — a run is being resumed; in the interrupted iteration (iter 2), member
+#   stage "build" completed and member stage "test" was interrupted before
+#   completing; persisted state records build as complete within iter 2.
+#   _ZBUILD_RESUME_ACTIVE=true is exported.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+
+# Use zb_engine_loop_state to write cycle state: 2 rounds (iter 1 finished,
+# iter 2 in_progress = current interrupted iter). After this call,
+# cycle_iterations["build-test"].current_iter = 2.
+zb_engine_loop_state "$STATE_FILE" "build-test" 2 5 "in_progress"
+
+# Record that "build" completed in iter 2 before the interruption.
+# stage_statuses.build = "complete" is the standard field the cycle orchestrator
+# checks to decide whether to skip a member on resume (ADR-006 §3.6 / CMBR-1).
+# Use jq to merge this into the existing state; the cycle_iterations block
+# written by zb_engine_loop_state is preserved (`.` merge keeps all other fields).
+jq '.stage_statuses.build = "complete"' "$STATE_FILE" \
+    > "${STATE_FILE}.cmbr1.tmp" && mv "${STATE_FILE}.cmbr1.tmp" "$STATE_FILE"
+
+# Load the template: cycle-converges-iter2.yaml has build + test as cycle members,
+# matching the state above.
+load_template "$FIXT/cycle-converges-iter2.yaml"
+
+# Track which cycle members are dispatched. cycle_dispatch_stage is what causes
+# stage.start events in a unit-test context; not being called for "build" is
+# functionally equivalent to no stage.start for build.
+_CMBR1_BUILD_DISPATCHED=0
+_CMBR1_TEST_DISPATCHED=0
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$stage" == "build" ]]; then
+        _CMBR1_BUILD_DISPATCHED=1
+    elif [[ "$stage" == "test" ]]; then
+        _CMBR1_TEST_DISPATCHED=1
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+zb_stub_reports_tests test
+
+# When — _ZBUILD_RESUME_ACTIVE=true is exported and the cycle orchestrator
+#   dispatches members of iter k (iter 2). "build" is complete; "test" is pending.
+set +e
+export _ZBUILD_RESUME_ACTIVE=true
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_cmbr1_rc=$?
+set -e
+
+# Then — no stage.start event for "build" (already complete in iter k):
+# cycle_dispatch_stage must NOT be called for "build" in iter 2.
+# Before the change: orchestrator does not check member state on resume →
+#   dispatches build regardless → _CMBR1_BUILD_DISPATCHED=1 → assert 0==1 → FAILS.
+# After the change: orchestrator sees stage_statuses.build=complete in iter 2 →
+#   skips build → _CMBR1_BUILD_DISPATCHED=0 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] no stage.start for 'build' in iter 2 (complete member skipped on resume within interrupted iter)" \
+    "0" "$_CMBR1_BUILD_DISPATCHED"
+
+# Then — stage.start is emitted for "test" (the interrupted member of iter k):
+# cycle_dispatch_stage must be called for "test" in iter 2.
+# Before the change: if orchestrator skips ALL members or aborts, test never
+#   dispatches → _CMBR1_TEST_DISPATCHED=0 → assert 1==0 → FAILS.
+# After the change: orchestrator skips build, dispatches test →
+#   _CMBR1_TEST_DISPATCHED=1 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] stage.start emitted for 'test' in iter 2 (interrupted cycle member dispatched on resume)" \
+    "1" "$_CMBR1_TEST_DISPATCHED"
+
+# ── [#1805/CMBR-1] iter=1 scenario: most common interruption point ────────────
+# Red-team finding: CMBR-1 skip guard must work for any interrupted iteration,
+# including iter=1 (the most common first-failure point). The guard must NOT
+# require _start_iter > 1; if it does, complete iter-1 members are re-dispatched.
+print_test_section "[#1805/CMBR-1] iter=1 interrupted: build complete in iter=1 is skipped, test dispatched"
+
+# Given — a run is being resumed; in the interrupted iteration (iter 1), member
+#   stage "build" completed and member stage "test" was interrupted before
+#   completing; persisted state records build as complete within iter 1.
+#   _ZBUILD_RESUME_ACTIVE=true is exported.
+: > "$ZBUILD_EVENTS_JSONL"
+jq -n '{schema_version:1, stage_statuses:{}, updated_at:"seed"}' > "$STATE_FILE"
+
+# Use zb_engine_loop_state to write cycle state: 1 round → current_iter=1
+# (interrupted during iter 1; this is the most common interruption scenario).
+# cycle_iterations["build-test"].current_iter = 1 (_start_iter = 1 on resume).
+zb_engine_loop_state "$STATE_FILE" "build-test" 1 5 "in_progress"
+
+# Record that "build" completed in iter 1 before the interruption.
+# stage_statuses.build = "complete" is what the cycle orchestrator checks to
+# decide whether to skip a member on resume (ADR-006 §3.6 / CMBR-1).
+jq '.stage_statuses.build = "complete"' "$STATE_FILE" \
+    > "${STATE_FILE}.cmbr1i1.tmp" && mv "${STATE_FILE}.cmbr1i1.tmp" "$STATE_FILE"
+
+# Load the template: same cycle-converges-iter2.yaml, build + test as cycle members.
+load_template "$FIXT/cycle-converges-iter2.yaml"
+
+# Track which cycle members are dispatched. cycle_dispatch_stage causes stage.start
+# events in a unit-test context; not being called for "build" is functionally
+# equivalent to no stage.start for build.
+_CMBR1I1_BUILD_DISPATCHED=0
+_CMBR1I1_TEST_DISPATCHED=0
+cycle_dispatch_stage() {
+    local stage="$1" iter="$2"
+    if [[ "$stage" == "build" ]]; then
+        _CMBR1I1_BUILD_DISPATCHED=1
+    elif [[ "$stage" == "test" ]]; then
+        _CMBR1I1_TEST_DISPATCHED=1
+    fi
+    _CYCLE_DISPATCH_VERDICT="pass"
+    _CYCLE_DISPATCH_STATUS="complete"
+    return 0
+}
+
+zb_stub_reports_tests test
+
+# When — _ZBUILD_RESUME_ACTIVE=true is exported and the cycle orchestrator
+#   dispatches members of iter 1. "build" is complete; "test" is pending.
+set +e
+export _ZBUILD_RESUME_ACTIVE=true
+cycle_orchestrator_run "build-test" "$ZBUILD_STATE_DIR" "$STATE_FILE"
+_cmbr1i1_rc=$?
+set -e
+
+# Then — no stage.start event for "build" (already complete in iter 1).
+# cycle_dispatch_stage must NOT be called for "build" in iter 1.
+# Before the fix: CMBR-1 guard requires _start_iter > 1; for _start_iter=1 the
+#   condition is false, _cid_resume_first_iter stays false → build IS dispatched →
+#   _CMBR1I1_BUILD_DISPATCHED=1 → assert 0==1 → FAILS (exposes the code bug).
+# After the fix: guard works for _start_iter=1 too → build is skipped →
+#   _CMBR1I1_BUILD_DISPATCHED=0 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] no stage.start for 'build' in iter 1 (complete member skipped on resume within interrupted iter=1; CMBR-1 guard must work for _start_iter=1 not only _start_iter>1)" \
+    "0" "$_CMBR1I1_BUILD_DISPATCHED"
+
+# Then — stage.start is emitted for "test" (the interrupted member of iter 1).
+# cycle_dispatch_stage must be called for "test" in iter 1.
+# Before the fix: build is re-dispatched and test may also run, but the guard
+#   failure means the skip invariant is violated.
+# After the fix: build is skipped, test is dispatched →
+#   _CMBR1I1_TEST_DISPATCHED=1 → PASSES.
+assert_eq \
+    "[#1805/CMBR-1] stage.start emitted for 'test' in iter 1 (interrupted cycle member dispatched; CMBR-1 applies to iter=1 not only iter>1)" \
+    "1" "$_CMBR1I1_TEST_DISPATCHED"
+
+# ── CYCL-1: test uses a fixture containing a cyclic stage ────────────────────
+print_test_section "resume-loop-state test uses a fixture containing a cyclic stage"
+
+# cycle-converges-iter2.yaml is loaded above via load_template and driven through
+# cycle_orchestrator_run. Assert it contains type: cycle to formally pin the fixture
+# contains a cyclic stage (as CYCL-1 requires).
+_s13_loop_fixt_content="$(cat "$FIXT/cycle-converges-iter2.yaml")"
+assert_contains "cycle fixture used by resume-loop-state test has type: cycle" \
+    "$_s13_loop_fixt_content" "type: cycle"
+
+# Also assert the pipeline was actually run: cycle_dispatch_stage was invoked
+# during cycle_orchestrator_run above, setting _SPEC7_FIRST_ITER from its
+# initial -1. A value > -1 proves the cyclic stage was dispatched.
+assert_gt \
+    "resume-loop-state ran the cyclic pipeline (cycle_dispatch_stage was invoked)" \
+    "$_SPEC7_FIRST_ITER" "-1"
+
+cleanup_test_env
+print_test_results
+exit $((FAIL > 0))
diff --git a/tests/integration/resume-rehydrate-test.sh b/tests/integration/resume-rehydrate-test.sh
