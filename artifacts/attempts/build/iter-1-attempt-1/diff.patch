+# ─── SPEC-22: provides.events retains both declared events ───────────────────
+print_test_section "SPEC-22: provides.events retains both events"
+
+_ev22a="$(grep -c 'plugin\.pr_open\.branch_fallback_used' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-22] pr-open manifest retains plugin.pr_open.branch_fallback_used" "1" "$_ev22a"
+
+_ev22b="$(grep -c 'plugin\.pr_open\.preflight_remote_has_work' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-22] pr-open manifest retains plugin.pr_open.preflight_remote_has_work" "1" "$_ev22b"
+
+# ─── Source plugin and set up helpers ────────────────────────────────────────
+# shellcheck source=../../plugins/tool/pr-open/plugin.sh
+source "$REPO_ROOT/plugins/tool/pr-open/plugin.sh"
+
+_setup_state() {
+    local tag="$1" has_review="${2:-yes}" has_advisory="${3:-no}"
+    local d="$TEST_TEMP_DIR/run-${tag}"
+    mkdir -p "$d/artifacts"
+    printf '{"issue":1849,"branch":"zbuild/issue-1849"}\n' > "$d/pipeline-state.json"
+    if [[ "$has_review" == "yes" ]]; then
+        printf '{"schema_version":1,"verdict":"approve","summary":"ok"}\n' > "$d/artifacts/review.json"
+    fi
+    if [[ "$has_advisory" == "yes" ]]; then
+        printf '{"findings":[],"lenses":[]}\n' > "$d/artifacts/review-report.json"
+    fi
+    printf '%s/pipeline-state.json' "$d"
+}
+
+_result_field() {
+    local f="$1" field="$2"
+    jq -r "${field} // empty" "$f" 2>/dev/null || true
+}
+
+_mock_git_pass() {
+    git() {
+        case "${1:-} ${2:-}" in
+            "rev-parse --abbrev-ref") echo "zbuild/issue-1849" ;;
+            "rev-parse --show-toplevel") echo "/tmp/mock" ;;
+            "rev-parse --verify") return 0 ;;
+            "rev-list --count") echo "1" ;;
+            *) return 0 ;;
+        esac
+    }
+    export -f git
+}
+
+_mock_gh_pass() {
+    gh() {
+        case "${1:-} ${2:-}" in
+            "pr create") echo "https://github.com/mock/repo/pull/1849" ;;
+            "pr list") echo "" ;;
+            "pr edit") return 0 ;;
+            "pr view") echo "https://github.com/mock/repo/pull/1849" ;;
+            *) return 0 ;;
+        esac
+    }
+    export -f gh
+}
+
+# ─── SPEC-5 + SPEC-6: opened path ─────────────────────────────────────────────
+print_test_section "SPEC-5/6: opened — result_contract:2, v2 fields, rc=0"
+
+_sf_op="$(_setup_state opened yes no)"
+_art_op="$(dirname "$_sf_op")/artifacts"
+_mock_git_pass
+_mock_gh_pass
+
+_rc_op=0; ( pr_open_run "pr" "$_sf_op" ) >/dev/null 2>&1 || _rc_op=$?
+
+assert_eq "[SPEC-6] pr_open_run opened path returns rc=0" "0" "$_rc_op"
+assert_file_exists "[SPEC-5] pr-result.json written on opened path" "$_art_op/pr-result.json"
+
+if [[ -f "$_art_op/pr-result.json" ]]; then
+    assert_eq "[SPEC-5] result_contract==2 on opened path" "2" \
+        "$(_result_field "$_art_op/pr-result.json" '.result_contract')"
+    assert_eq "[SPEC-5] verdict==pass on opened path" "pass" \
+        "$(_result_field "$_art_op/pr-result.json" '.verdict')"
+    assert_eq "[SPEC-5] disposition==complete on opened path" "complete" \
+        "$(_result_field "$_art_op/pr-result.json" '.disposition')"
+    _r_op="$(_result_field "$_art_op/pr-result.json" '.reason')"
+    [[ -n "$_r_op" ]] && assert_pass "[SPEC-5] reason non-empty on opened path" \
+        || assert_fail "[SPEC-5] reason non-empty on opened path" "empty"
+fi
+unset -f git gh
+
+# ─── SPEC-5 + SPEC-6: branch_is_main path ────────────────────────────────────
+print_test_section "SPEC-5/6: branch_is_main — verdict=error, rc=1"
+
+_sf_bm="$(_setup_state bm yes no)"
+_art_bm="$(dirname "$_sf_bm")/artifacts"
+git() { case "${1:-} ${2:-}" in "rev-parse --abbrev-ref") echo "main" ;; *) return 0 ;; esac }
+export -f git
+
+_rc_bm=0; ( pr_open_run "pr" "$_sf_bm" ) >/dev/null 2>&1 || _rc_bm=$?
