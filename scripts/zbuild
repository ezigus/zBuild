#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  zBuild CLI (zbuild / zb)                                                 ║
# ║  Plugin-based framework for autonomous AI agent delivery pipelines        ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
set -euo pipefail

VERSION="1.0.0"   # fallback; overridden by the VERSION file resolved below

# Resolve symlinks (npm global install symlinks bin/ to node_modules/)
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

# Canonical version lives in the VERSION file. install.sh copies it to
# config/VERSION; in a source checkout it also sits at the repo root ($SCRIPT_DIR/../VERSION).
# Probe config/VERSION FIRST: post-install $SCRIPT_DIR/../VERSION == $ZBUILD_HOME/VERSION,
# which on a case-insensitive filesystem (macOS default) is the SAME inode as the lowercase
# `version` install-metadata file (sha=/branch=...) — reading it would print "sha=..." as the
# semver. The shape guard below rejects that collision and any other non-semver content.
# The version may be 3-part (legacy SemVer) or 4-part A.B.C.D (ADR-048).
for _vf in "$SCRIPT_DIR/../config/VERSION" "$SCRIPT_DIR/../VERSION"; do
    if [[ -f "$_vf" ]]; then
        _cand="$(<"$_vf")"
        if [[ "$_cand" =~ ^[0-9]+(\.[0-9]+){2,3}$ ]]; then VERSION="$_cand"; break; fi
    fi
done
unset _vf _cand

# shellcheck source=lib/helpers.sh
source "$SCRIPT_DIR/lib/helpers.sh"

usage() {
    cat <<EOF
zBuild ${VERSION} — plugin-based framework for autonomous AI agent delivery pipelines.

Usage:
  zbuild <command> [args...]
  zbuild --resume <run_id>    Resume a specific interrupted run by run_id
  zbuild --resume-latest      Resume the most recent interrupted run
  zbuild --attach <run_id>    Attach to (tail) the event log for a running pipeline

Commands:
  --version, version     Print version (semver from the VERSION file; sha/branch
                         from \$ZBUILD_HOME/version install metadata when set)
  upgrade --from <dir>   Re-run install.sh from a source clone (pulls main first)
  upgrade --tag <vX>     Fetch a release tarball by tag, verify checksum/signature
                         BEFORE applying, then install (refuses on tamper)
  --help, help, -h       Show this help
  status                 Show pipeline status (Phase 0 stub — JSON only)
  plugin list            List discovered plugins
  doctor                 Validate install and configuration (bash>=5, claude, gh, sqlite3, etc.)
  pipeline start         Start a pipeline (--issue <N>|--goal "<text>") [--dry-run]
                         [--platform-override <p>] [--scope <path>]...
                         [--no-resume]
                         [--mcp-server <url>]... [--mcp-transport stdio|sse]
                         [--mcp-timeout <seconds>]
  pipeline resume        Resume most recent interrupted/in_progress run
                         [--run-id <id>] [--from-stage <stage>] [--force]
  pipeline status        Show resume recommendation for the current state file
                         [--run-id <id>]
  cleanup                Prune stale zbuild/issue-* branches + old state files
                         + zb-applycheck-* stashes + leaked zbuild tmpdirs
                         (patterns: ZBUILD_TMPDIR_PATTERNS in lib/cleanup.sh).
                         Also prunes worktree orphans.
                         [--branches] [--state-dirs] [--stashes] [--tmpdirs]
                         [--dry-run|--apply|--force]
                         [--age-days N]    (state files; default 14)
                         [--age-hours N]   (stashes + tmpdirs; default 1)
                         [--restore-stash <N> --apply]  (pop a zb-applycheck stash
                                                          to working tree, then drop)
                         [--quiet]
                         Default: dry-run, all categories.
  release                Cut a release: compute version, generate per-issue
                         release notes, update CHANGELOG.md, stamp VERSION, tag,
                         and publish the GitHub release.
                         [--dry-run] [--major|--minor|--patch] [--force] [--ship] [--yes] [--milestone <name>]
  vision init            Create or update the project vision document (ADR-049).
                         Default output: .zbuild/vision.md
                         [--blank]              Write a minimal conforming skeleton (no LLM)
                         [--condense]           Condense the existing vision to ≤300 words
                         [--output <path>]      Override the output file path
  docs generate <spec>   Generate a wiki page for a plugin or mechanic (DOC-D2).
                         <spec> is 'plugin:<id>' or 'mechanic:<name>'.
  docs generate --all    Generate wiki pages for every plugin and mechanic (DOC-D3).
  docs publish           Regen pages, refresh README, push docs/wiki to .wiki.git (DOC-F).
                         Flags: --dry-run | --regen-only | --wiki-only | --version <v>.
  deferred <sub>         Deferred-work scanners (backfill | tracker)
                         Run \`zbuild deferred --help\` for sub-commands.
  manifest <sub>         Manifest YAML drift management (sync)
                         Run \`zbuild manifest --help\` for sub-commands.

Session flags (shortcuts):
  --resume <run_id>      Shorthand for: pipeline resume --run-id <run_id>
                         Exports ZBUILD_RESUME_RUN_ID for the runner.
  --resume-latest        Reads run_id from state/pipeline-state.json and resumes it.
  --attach <run_id>      Tails state/events.jsonl filtered to the given run_id.

MCP flags (pipeline start):
  --mcp-server <url>     MCP server URL to connect to (repeatable for multiple servers).
                         Exported as ZBUILD_MCP_SERVERS (newline-delimited).
  --mcp-transport <type> Transport type: stdio or sse.
                         Exported as ZBUILD_MCP_TRANSPORT (consumer defaults apply when unset).
  --mcp-timeout <secs>   Positive integer; connection timeout in seconds.
                         Exported as ZBUILD_MCP_TIMEOUT (consumer defaults apply when unset).

See https://github.com/ezigus/zBuild/issues for the migration backlog.

Documentation:
  docs/KEEPERS.md        Behaviors preserved from shipwright
  docs/ARCHITECTURE.md   System view and plugin contract
  docs/adr/              Architecture decisions
EOF
}

# _find_state_file <state_dir> <run_id>
# Locates a state file: by run_id scan when <run_id> is non-empty, else default path.
# Prints the path on success; exits 1 on failure.
_find_state_file() {
    local state_dir="$1" run_id="$2"
    if [[ -n "$run_id" ]]; then
        local f
        # #887: scan per-run dirs (runs/<id>/) AND the legacy flat path (back-compat).
        for f in "$state_dir"/runs/*/pipeline-state*.json "$state_dir"/pipeline-state*.json; do
            [[ -f "$f" ]] || continue
            if jq -e --arg id "$run_id" '.run_id == $id' "$f" >/dev/null 2>&1; then
                echo "$f"; return 0
            fi
        done
        error "No state file found for run-id: $run_id"
        exit 1
    fi
    # #887: no run_id → prefer the latest-run pointer; fall back to flat legacy.
    if [[ -L "$state_dir/latest" && -f "$state_dir/latest/pipeline-state.json" ]]; then
        echo "$state_dir/latest/pipeline-state.json"; return 0
    fi
    echo "$state_dir/pipeline-state.json"
}

# ─── Top-level session/interrupt-resume flags ──────────────────────────────
# These are shortcuts; they resolve to the pipeline subcommand machinery below
# but are exposed as first-class flags for convenience and scriptability.
#
# --resume <run_id>
#   Locate the state file for <run_id>, export ZBUILD_RESUME_RUN_ID, then
#   hand off to `pipeline resume --run-id <run_id>`.
#
# --resume-latest
#   Read run_id from the default state file (state/pipeline-state.json) and
#   hand off to `pipeline resume --run-id <run_id>`.
#
# --attach <run_id>
#   Tail state/events.jsonl, filtering to lines whose run_id matches.
#   Exits when the pipeline process ends (SIGPIPE from tail).
#
# Implementation note: we exec/delegate into the pipeline case block rather
# than duplicating logic, so all the guard-rails (status checks, --force,
# state-file export) run exactly once in pipeline resume.

if [[ "${1:-}" == "--resume" ]]; then
    [[ -z "${2:-}" ]] && { error "--resume requires a run_id"; usage; exit 2; }
    _resume_run_id="$2"
    export ZBUILD_RESUME_RUN_ID="$_resume_run_id"
    # Re-enter via the pipeline resume subcommand path
    set -- pipeline resume --run-id "$_resume_run_id" "${@:3}"
fi

if [[ "${1:-}" == "--resume-latest" ]]; then
    _state_dir="${ZBUILD_STATE_DIR:-${ZBUILD_STATE_ROOT:-$HOME/.zbuild/state}}"
    # #887: most-recent run lives under runs/<id>/ via the `latest` pointer;
    # fall back to the legacy flat state file.
    if [[ -L "$_state_dir/latest" && -f "$_state_dir/latest/pipeline-state.json" ]]; then
        _state_file="$_state_dir/latest/pipeline-state.json"
    else
        _state_file="$_state_dir/pipeline-state.json"
    fi
    if [[ ! -f "$_state_file" ]]; then
        error "--resume-latest: no state file found at $_state_file; nothing to resume"
        exit 1
    fi
    _latest_run_id="$(jq -r '.run_id // empty' "$_state_file" 2>/dev/null)"
    if [[ -z "$_latest_run_id" ]]; then
        error "--resume-latest: state file exists but contains no run_id: $_state_file"
        exit 1
    fi
    export ZBUILD_RESUME_RUN_ID="$_latest_run_id"
    set -- pipeline resume --run-id "$_latest_run_id" "${@:2}"
fi

if [[ "${1:-}" == "--attach" ]]; then
    [[ -z "${2:-}" ]] && { error "--attach requires a run_id"; usage; exit 2; }
    _attach_run_id="$2"
    _state_dir="${ZBUILD_STATE_DIR:-${ZBUILD_STATE_ROOT:-$HOME/.zbuild/state}}"
    # #887: per-run runs write events to runs/<run_id>/events.jsonl. Find the
    # run's own state file by run_id (per-run dirs + legacy flat) WITHOUT the
    # exit-on-miss of _find_state_file, then take its sibling events.jsonl. An
    # operator-pinned ZBUILD_EVENTS_JSONL still wins; otherwise fall back to flat.
    if [[ -n "${ZBUILD_EVENTS_JSONL:-}" ]]; then
        _events_file="$ZBUILD_EVENTS_JSONL"
    else
        _events_file="$_state_dir/events.jsonl"
        _attach_f=""
        for _attach_f in "$_state_dir"/runs/*/pipeline-state*.json "$_state_dir"/pipeline-state*.json; do
            [[ -f "$_attach_f" ]] || continue
            if jq -e --arg id "$_attach_run_id" '.run_id == $id' "$_attach_f" >/dev/null 2>&1; then
                _events_file="$(dirname "$_attach_f")/events.jsonl"; break
            fi
        done
    fi
    if [[ ! -f "$_events_file" ]]; then
        error "--attach: event log not found at $_events_file"
        exit 1
    fi
    info "Attaching to run $_attach_run_id (Ctrl-C to detach)"
    # tail -F follows rotation; grep -F matches fixed string for the run_id field.
    # Use --line-buffered / -l so each event line appears immediately.
    exec tail -F "$_events_file" 2>/dev/null \
        | grep --line-buffered -F "\"run_id\":\"${_attach_run_id}\"" || true
    exit 0
fi

cmd="${1:-help}"
case "$cmd" in
    --version|version)
        # ADR-023: prefer $ZBUILD_HOME/version (written by install.sh) so the
        # printed metadata reflects the *installed* tree, not whatever the
        # source clone's HEAD is right now.
        echo "zbuild ${VERSION}"
        _zhome="${ZBUILD_HOME:-$HOME/.local/share/zbuild}"
        if [[ -f "$_zhome/version" ]]; then
            # shellcheck disable=SC1090
            while IFS='=' read -r k v; do
                [[ -z "$k" ]] && continue
                printf '  %s: %s\n' "$k" "$v"
            done < "$_zhome/version"
        else
            # Fallback: legacy install / source-clone invocation. Try git.
            _repo_root="$(cd "$SCRIPT_DIR/.." && pwd)"
            if _sha=$(git -C "$_repo_root" rev-parse HEAD 2>/dev/null); then
                _br=$(git -C "$_repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
                printf '  sha: %s\n  branch: %s\n  source: %s\n' "$_sha" "$_br" "$_repo_root"
                echo "  (no \$ZBUILD_HOME/version — reporting source clone HEAD)"
            else
                echo "  installed version unknown — please re-run install.sh"
            fi
        fi
        ;;
    upgrade)
        shift
        up_from=""
        up_tag=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --from)
                    [[ -z "${2:-}" ]] && { error "--from requires a directory"; exit 2; }
                    up_from="$2"; shift 2 ;;
                --tag)
                    [[ -z "${2:-}" ]] && { error "--tag requires a version tag (e.g. v1.0.0.0)"; exit 2; }
                    up_tag="$2"; shift 2 ;;
                -h|--help)
                    cat <<'UPHELP'
zbuild upgrade — refresh $ZBUILD_HOME from a source clone or a signed release.

Usage:
  zbuild upgrade --from <path-to-zbuild-source-clone>
  zbuild upgrade --tag  <vA.B.C.D>

--from (source clone):
  1. cd <dir>; git pull (best-effort; non-fatal if not a git checkout)
  2. exec <dir>/install.sh — copies the refreshed tree into $ZBUILD_HOME.
  The --from flag needs your source clone because $ZBUILD_HOME has no .git.

--tag (signed release artifact, ADR-023 — cuts+verifies an artifact, no registry):
  1. Fetch zbuild-<tag>.tar.gz + SHA256SUMS from the GitHub Release for <tag>.
  2. VERIFY the tarball (checksum, and signature if the signing backend
     provides one) BEFORE applying. Tamper/mismatch -> REFUSE, nothing applied.
  3. Extract the verified tarball and exec its install.sh into $ZBUILD_HOME.
UPHELP
                    exit 0 ;;
                *)
                    error "Unknown upgrade flag: $1"; exit 2 ;;
            esac
        done

        if [[ -n "$up_from" && -n "$up_tag" ]]; then
            error "zbuild upgrade: use exactly one of --from or --tag, not both"
            exit 2
        fi

        # ─── Signed-release path: fetch by tag, verify BEFORE applying ────────
        if [[ -n "$up_tag" ]]; then
            REPO_ROOT_UP="$(cd "$SCRIPT_DIR/.." && pwd)"
            # shellcheck source=../core/plugin-registry/registry.sh
            source "$REPO_ROOT_UP/core/plugin-registry/registry.sh"
            # shellcheck source=../core/config/config.sh
            source "$REPO_ROOT_UP/core/config/config.sh"
            # shellcheck source=lib/release-tarball.sh
            source "$SCRIPT_DIR/lib/release-tarball.sh"

            up_work="$(mktemp -d "${TMPDIR:-/tmp}/zbuild-upgrade.XXXXXX")"
            trap 'rm -rf "$up_work"' EXIT
            info "fetching release $up_tag and verifying before applying"
            up_tarball="$(fetch_verified_release "$up_tag" "$up_work/dl")" || {
                error "upgrade --tag: fetch or verification failed for $up_tag — NOT applied"
                exit 1
            }
            success "verified $up_tag (checksum/signature OK)"
            up_extract="$up_work/extract"; mkdir -p "$up_extract"
            tar -xzf "$up_tarball" -C "$up_extract" || { error "upgrade --tag: extract failed"; exit 1; }
            if [[ ! -f "$up_extract/install.sh" ]]; then
                error "upgrade --tag: verified tarball has no install.sh"
                exit 1
            fi
            info "applying verified release $up_tag"
            # Run install.sh as a SUBPROCESS (not exec): install.sh installs FROM
            # $up_extract, so the workdir must live for the duration of the call.
            # `exec` would replace this process and skip the EXIT trap, leaking the
            # mktemp workdir. A normal call lets the EXIT trap clean it afterwards.
            up_rc=0
            bash "$up_extract/install.sh" || up_rc=$?
            exit "$up_rc"
        fi

        # ─── Source-clone path (unchanged, ADR-023) ──────────────────────────
        if [[ -z "$up_from" ]]; then
            error "zbuild upgrade requires --from <source-dir> or --tag <version>"
            echo "  Example: zbuild upgrade --from ~/code/zBuild" >&2
            echo "  Example: zbuild upgrade --tag v1.0.0.0" >&2
            echo "  Run \`zbuild upgrade --help\` for details." >&2
            exit 2
        fi
        if [[ ! -d "$up_from" ]]; then
            error "--from directory not found: $up_from"
            exit 2
        fi
        if [[ ! -x "$up_from/install.sh" ]] && [[ ! -f "$up_from/install.sh" ]]; then
            error "no install.sh at $up_from/install.sh — is this a zBuild source clone?"
            exit 2
        fi
        info "upgrading zBuild from $up_from"
        if git -C "$up_from" rev-parse HEAD >/dev/null 2>&1; then
            git -C "$up_from" pull --ff-only 2>&1 || warn "git pull failed (continuing with current source state)"
        else
            warn "$up_from is not a git checkout; skipping pull"
        fi
        exec bash "$up_from/install.sh"
        ;;
    --help|help|-h)
        usage
        ;;
    status)
        info "zbuild status — Phase 0 stub"
        echo '{"status": "phase-0-stub", "version": "'"$VERSION"'"}'
        ;;
    doctor)
        # shellcheck source=lib/doctor.sh
        source "$SCRIPT_DIR/lib/doctor.sh"
        run_doctor "$VERSION"
        ;;
    plugin)
        # shellcheck source=../core/plugin-registry/registry.sh
        source "$(cd "$SCRIPT_DIR/.." && pwd)/core/plugin-registry/registry.sh"
        case "${2:-}" in
            list)
                info "zbuild plugins"
                printf "  %-20s %-12s %-10s %s\n" "ID" "KIND" "VERSION" "NAME"
                printf "  %-20s %-12s %-10s %s\n" "--" "----" "-------" "----"
                list_plugins_table
                ;;
            lock)
                lockfile_write
                success "wrote $ZBUILD_LOCKFILE"
                ;;
            validate)
                if lockfile_validate; then
                    success "lockfile validates clean"
                else
                    error "lockfile mismatches detected"
                    exit 1
                fi
                ;;
            *)
                error "Unknown plugin subcommand: ${2:-}"
                echo "Available: list, lock, validate" >&2
                exit 2
                ;;
        esac
        ;;
    pipeline)
        REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
        case "${2:-}" in
            start)
                shift 2
                # Pre-parse --platform-override, --scope, and --mcp-* before forwarding to runner.
                # All other args are forwarded verbatim.
                platform_override=""
                scope_paths=()
                mcp_servers=()
                mcp_transport=""
                mcp_timeout=""
                runner_args=()
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --platform-override)
                            [[ -z "${2:-}" ]] && { error "--platform-override requires a value"; usage; exit 2; }
                            platform_override="$2"; shift 2 ;;
                        --scope)
                            [[ -z "${2:-}" ]] && { error "--scope requires a value"; usage; exit 2; }
                            scope_paths+=("$2"); shift 2 ;;
                        --mcp-server)
                            [[ -z "${2:-}" ]] && { error "--mcp-server requires a value"; usage; exit 2; }
                            mcp_servers+=("$2"); shift 2 ;;
                        --mcp-transport)
                            [[ -z "${2:-}" ]] && { error "--mcp-transport requires a value"; usage; exit 2; }
                            case "$2" in
                                stdio|sse) mcp_transport="$2" ;;
                                *) error "--mcp-transport must be 'stdio' or 'sse', got: $2"; exit 1 ;;
                            esac
                            shift 2 ;;
                        --mcp-timeout)
                            [[ -z "${2:-}" ]] && { error "--mcp-timeout requires a value"; usage; exit 2; }
                            case "$2" in
                                ''|*[!0-9]*|0) error "--mcp-timeout must be a positive integer, got: $2"; exit 2 ;;
                            esac
                            mcp_timeout="$2"; shift 2 ;;
                        *)
                            runner_args+=("$1"); shift ;;
                    esac
                done
                if [[ -n "$platform_override" ]]; then
                    export ZBUILD_PLATFORM_OVERRIDE="$platform_override"
                fi
                if [[ ${#mcp_servers[@]} -gt 0 ]]; then
                    export ZBUILD_MCP_SERVERS
                    ZBUILD_MCP_SERVERS="$(printf '%s\n' "${mcp_servers[@]}")"
                fi
                if [[ -n "$mcp_transport" ]]; then
                    export ZBUILD_MCP_TRANSPORT="$mcp_transport"
                fi
                if [[ -n "$mcp_timeout" ]]; then
                    export ZBUILD_MCP_TIMEOUT="$mcp_timeout"
                fi
                if [[ ${#scope_paths[@]} -gt 0 ]]; then
                    # Validate paths: reject absolute paths and directory traversal.
                    for _sp in "${scope_paths[@]}"; do
                        if [[ "$_sp" == /* ]]; then
                            error "--scope: absolute paths are not allowed: $_sp"
                            exit 2
                        fi
                        if [[ "$_sp" == *..* ]]; then
                            error "--scope: paths containing '..' are not allowed: $_sp"
                            exit 2
                        fi
                    done
                    unset _sp
                    # Export as newline-delimited string to preserve paths with spaces.
                    export ZBUILD_SCOPE_PATHS
                    ZBUILD_SCOPE_PATHS="$(printf '%s\n' "${scope_paths[@]}")"
                fi
                exec bash "$REPO_ROOT/core/pipeline/runner.sh" "${runner_args[@]+"${runner_args[@]}"}"
                ;;
            resume)
                shift 2
                run_id=""
                force=false
                runner_args=(--resume)
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --run-id)
                            [[ -z "${2:-}" ]] && { error "--run-id requires a value"; usage; exit 2; }
                            run_id="$2"; shift 2 ;;
                        --from-stage)
                            [[ -z "${2:-}" ]] && { error "--from-stage requires a value"; usage; exit 2; }
                            runner_args+=(--from-stage "$2"); shift 2 ;;
                        --force)
                            force=true; runner_args+=(--force); shift ;;
                        *)
                            runner_args+=("$1"); shift ;;
                    esac
                done

                state_dir="${ZBUILD_STATE_DIR:-${ZBUILD_STATE_ROOT:-$HOME/.zbuild/state}}"
                state_file="$(_find_state_file "$state_dir" "$run_id")"
                # Always export ZBUILD_STATE_FILE so runner.sh knows which file to use
                export ZBUILD_STATE_FILE="$state_file"

                if [[ ! -f "$state_file" ]]; then
                    error "No state file found at $state_file; nothing to resume"
                    exit 1
                fi

                # shellcheck source=../core/state/atomic.sh
                source "$REPO_ROOT/core/state/atomic.sh"
                # shellcheck source=../core/state/resume.sh
                source "$REPO_ROOT/core/state/resume.sh"

                cur_status="$(get_state_field "$state_file" '.status' '')"
                if [[ "$cur_status" == "aborted" ]] && ! $force; then
                    error "Pipeline status is 'aborted'; use --force to resume anyway"
                    exit 1
                fi
                if [[ "$cur_status" == "complete" ]]; then
                    warn "Pipeline status is 'complete'; nothing to resume (start a new run)"
                    exit 1
                fi

                saved_issue="$(get_state_field "$state_file" '.issue' '0')"
                saved_goal="$(get_state_field "$state_file" '.goal' '')"

                # Rebuild runner args: goal-based runs store goal in state (issue==0)
                if [[ "$saved_issue" == "0" && -n "$saved_goal" ]]; then
                    runner_args+=(--goal "$saved_goal")
                else
                    runner_args+=(--issue "$saved_issue")
                fi

                set_state_field "$state_file" '.status' '"in_progress"'

                export ZBUILD_STATE_DIR="$state_dir"
                exec bash "$REPO_ROOT/core/pipeline/runner.sh" "${runner_args[@]}"
                ;;
            status)
                shift 2
                run_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --run-id)
                            [[ -z "${2:-}" ]] && { error "--run-id requires a value"; usage; exit 2; }
                            run_id="$2"; shift 2 ;;
                        *)
                            shift ;;
                    esac
                done

                state_dir="${ZBUILD_STATE_DIR:-${ZBUILD_STATE_ROOT:-$HOME/.zbuild/state}}"
                state_file="$(_find_state_file "$state_dir" "$run_id")"

                if [[ ! -f "$state_file" ]]; then
                    info "No pipeline state found at $state_file"
                    echo '{"recommendation": "fresh_start", "reason": "no_state_file"}'
                    exit 0
                fi

                # shellcheck source=../core/state/atomic.sh
                source "$REPO_ROOT/core/state/atomic.sh"
                # shellcheck source=../core/state/resume.sh
                source "$REPO_ROOT/core/state/resume.sh"

                info "Pipeline state: $state_file"
                jq -n \
                    --arg run_id    "$(get_state_field "$state_file" '.run_id' '')" \
                    --arg status    "$(get_state_field "$state_file" '.status' '')" \
                    --arg updated_at "$(get_state_field "$state_file" '.updated_at' '')" \
                    --arg recommendation "$(get_resume_recommendation "$state_file")" \
                    '{run_id: $run_id, status: $status, updated_at: $updated_at, recommendation: $recommendation}'
                ;;
            *)
                error "Unknown pipeline subcommand: ${2:-}"
                echo "Available: start, resume, status" >&2
                exit 2
                ;;
        esac
        ;;
    cleanup)
        shift
        # shellcheck source=lib/cleanup.sh
        source "$SCRIPT_DIR/lib/cleanup.sh"
        cl_branches=false
        cl_state_dirs=false
        cl_stashes=false
        cl_tmpdirs=false
        cl_dry_run=""
        cl_force=false
        cl_age_days=14
        cl_age_hours=1
        cl_quiet=false
        cl_restore_idx=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --branches)   cl_branches=true; shift ;;
                --state-dirs) cl_state_dirs=true; shift ;;
                --stashes)    cl_stashes=true; shift ;;
                --tmpdirs)    cl_tmpdirs=true; shift ;;
                --dry-run)    cl_dry_run=true; shift ;;
                --apply)      cl_dry_run=false; shift ;;
                --force)      cl_force=true; cl_dry_run="${cl_dry_run:-false}"; shift ;;
                --age-days)
                    [[ -z "${2:-}" ]] && { error "--age-days requires a value"; exit 2; }
                    case "$2" in
                        ''|*[!0-9]*) error "--age-days must be a non-negative integer, got: $2"; exit 2 ;;
                    esac
                    cl_age_days="$2"; shift 2 ;;
                --age-hours)
                    [[ -z "${2:-}" ]] && { error "--age-hours requires a value"; exit 2; }
                    case "$2" in
                        ''|*[!0-9]*) error "--age-hours must be a non-negative integer, got: $2"; exit 2 ;;
                    esac
                    cl_age_hours="$2"; shift 2 ;;
                --restore-stash)
                    [[ -z "${2:-}" ]] && { error "--restore-stash requires a stash index"; exit 2; }
                    case "$2" in
                        ''|*[!0-9]*) error "--restore-stash requires a non-negative integer, got: $2"; exit 2 ;;
                    esac
                    cl_restore_idx="$2"; shift 2 ;;
                --quiet) cl_quiet=true; shift ;;
                *)
                    error "Unknown cleanup flag: $1"
                    echo "Usage: zbuild cleanup [--branches] [--state-dirs] [--stashes] [--tmpdirs]" >&2
                    echo "                       [--dry-run|--apply|--force]" >&2
                    echo "                       [--age-days N] [--age-hours N] [--quiet]" >&2
                    echo "                       [--restore-stash <index> --apply]" >&2
                    exit 2 ;;
            esac
        done
        # --restore-stash short-circuits: mutually exclusive with category/force.
        if [[ -n "$cl_restore_idx" ]]; then
            if $cl_force; then
                error "--restore-stash cannot be combined with --force"
                exit 2
            fi
            # Default to dry-run if neither --apply nor --dry-run set.
            [[ -z "$cl_dry_run" ]] && cl_dry_run=true
            if $cl_dry_run; then
                $cl_quiet || info "would restore stash@{$cl_restore_idx} (use --apply to act)"
                exit 0
            fi
            if _cleanup_restore_stash "$cl_restore_idx"; then
                $cl_quiet || info "restored stash@{$cl_restore_idx} to working tree"
                exit 0
            else
                exit 1
            fi
        fi
        # Default = dry-run when neither --apply nor --force specified.
        [[ -z "$cl_dry_run" ]] && cl_dry_run=true
        # Default categories: all when no category flag was set.
        if ! $cl_branches && ! $cl_state_dirs && ! $cl_stashes && ! $cl_tmpdirs; then
            cl_branches=true
            cl_state_dirs=true
            cl_stashes=true
            cl_tmpdirs=true
        fi

        $cl_quiet || {
            if $cl_dry_run; then info "zbuild cleanup (dry-run; --apply or --force to act)"
            else info "zbuild cleanup (applying)"; fi
        }

        if $cl_state_dirs; then
            cl_state_dir="${ZBUILD_STATE_DIR:-${ZBUILD_STATE_ROOT:-$HOME/.zbuild/state}}"
            cl_state_candidates="$(_cleanup_scan_state_files "$cl_state_dir" "$cl_age_days" "$cl_force" || true)"
            _cleanup_render_plan "state files" "$cl_state_candidates" "$cl_dry_run" "$cl_quiet"
            _cleanup_apply_plan "$cl_state_candidates" "$cl_dry_run"
        fi

        if $cl_branches; then
            cl_branch_plan="$(_cleanup_scan_branches "$cl_force" || true)"
            _cleanup_render_plan "branches" "$cl_branch_plan" "$cl_dry_run" "$cl_quiet"
            _cleanup_apply_branch_plan "$cl_branch_plan" "$cl_dry_run"
        fi

        if $cl_stashes; then
            # Note: only meaningful inside a git work tree.
            if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                cl_stash_plan="$(_cleanup_scan_stashes "$cl_force" "$cl_age_hours" || true)"
                _cleanup_render_plan "stashes" "$cl_stash_plan" "$cl_dry_run" "$cl_quiet"
                _cleanup_apply_stash_plan "$cl_stash_plan" "$cl_dry_run"
            fi
        fi

        if $cl_tmpdirs; then
            cl_tmp_plan="$(_cleanup_scan_zbuild_tmpdirs "$cl_age_hours" || true)"
            _cleanup_render_plan "tmpdirs" "$cl_tmp_plan" "$cl_dry_run" "$cl_quiet"
            # #752: apply lives in cleanup.sh next to the scanner so both
            # read ZBUILD_TMPDIR_PATTERNS — an inline whitelist here drifted
            # from the scanner twice (#628, #749).
            _cleanup_apply_tmpdir_plan "$cl_tmp_plan" "$cl_dry_run"
        fi

        # Auto-prune worktree orphans (cheap, idempotent; only inside a repo).
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            if [[ "$cl_dry_run" != "true" ]]; then
                git worktree prune >/dev/null 2>&1 || true
            fi
        fi
        ;;
    release)
        # #1466: default cadence is --minor when no explicit cadence flag is given.
        # Scan forwarded args; inject --minor only when no --patch/--minor/--major found.
        # release.sh's internal --patch default is NOT changed (direct callers unaffected).
        shift
        _rel_cadence=""
        for _rel_arg in "$@"; do
            case "$_rel_arg" in
                --patch|--minor|--major) _rel_cadence="$_rel_arg"; break ;;
            esac
        done
        unset _rel_arg
        if [[ -z "$_rel_cadence" ]]; then
            exec bash "$SCRIPT_DIR/release.sh" --minor "$@"
        else
            exec bash "$SCRIPT_DIR/release.sh" "$@"
        fi
        ;;
    deferred)
        case "${2:-}" in
            backfill)
                shift 2
                exec bash "$SCRIPT_DIR/deferred-backfill.sh" "$@"
                ;;
            tracker)
                shift 2
                exec bash "$SCRIPT_DIR/deferred-tracker.sh" "$@"
                ;;
            ""|-h|--help)
                cat <<'HELP'
zbuild deferred — deferred-work scanners.

Sub-commands:
  backfill   One-shot historical scan; terminal output (manual use).
  tracker    Recurring scan; creates/updates a triage issue (mostly automated).

Default mode for each sub-command is --report (read-only, safe).

Run any sub-command with --help for full details:
  zbuild deferred backfill --help
  zbuild deferred tracker --help
HELP
                ;;
            *)
                error "Unknown deferred subcommand: $2"
                echo "Available: backfill, tracker" >&2
                echo "Run: zbuild deferred --help" >&2
                exit 2
                ;;
        esac
        ;;
    manifest)
        case "${2:-}" in
            sync)
                shift 2
                exec bash "$SCRIPT_DIR/manifest-sync.sh" "$@"
                ;;
            ""|-h|--help)
                cat <<'HELP'
zbuild manifest — manifest YAML drift management.

Sub-commands:
  sync   Detect drift between keepers-manifest.yaml and live GitHub state.

Default mode is --report (read-only, safe).

Run: zbuild manifest sync --help for full details.
HELP
                ;;
            *)
                error "Unknown manifest subcommand: $2"
                echo "Available: sync" >&2
                echo "Run: zbuild manifest --help" >&2
                exit 2
                ;;
        esac
        ;;
    vision)
        case "${2:-}" in
            init)
                shift 2
                # shellcheck source=lib/vision-init.sh
                source "$SCRIPT_DIR/lib/vision-init.sh"
                _vi_blank=false
                _vi_condense=false
                _vi_output=".zbuild/vision.md"
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --blank)    _vi_blank=true; shift ;;
                        --condense) _vi_condense=true; shift ;;
                        --output)
                            [[ -z "${2:-}" ]] && { error "--output requires a path"; exit 2; }
                            _vi_output="$2"; shift 2 ;;
                        -h|--help)
                            cat <<'VIHELP'
zbuild vision init — create or update the project vision document.

Usage:
  zbuild vision init [--blank] [--condense] [--output <path>]

  (no flags)       Auto-draft a vision document from repo context (requires LLM)
  --blank          Write a minimal conforming skeleton (no LLM needed)
  --condense       Condense the existing vision document to ≤300 words (requires LLM)
  --output <path>  Override the default output path (.zbuild/vision.md)

The vision gate (ADR-049) requires a conforming vision document before any
pipeline run. If the gate blocks you, run one of the above to create one.
VIHELP
                            exit 0 ;;
                        *)
                            error "Unknown vision init flag: $1"; exit 2 ;;
                    esac
                done
                if $_vi_blank && $_vi_condense; then
                    error "vision init: --blank and --condense are mutually exclusive"
                    exit 2
                fi
                if $_vi_blank; then
                    vision_init_blank "$_vi_output" && success "wrote blank vision document: $_vi_output"
                elif $_vi_condense; then
                    # Locate the existing vision doc to condense
                    _vi_existing="$(load_vision_doc "$PWD" 2>/dev/null)" || true
                    if [[ -z "$_vi_existing" ]]; then
                        error "vision init --condense: no existing vision document found"
                        echo "Run: zbuild vision init (to auto-draft) or zbuild vision init --blank" >&2
                        exit 1
                    fi
                    vision_condense "$_vi_existing" "$_vi_output" && success "condensed vision document: $_vi_output"
                else
                    vision_init_draft "$PWD" "$_vi_output" && success "drafted vision document: $_vi_output"
                fi
                ;;
            ""|-h|--help)
                cat <<'VHELP'
zbuild vision — vision document management (ADR-049).

Sub-commands:
  init   Create or update the project vision document.

Run: zbuild vision init --help for full details.
VHELP
                ;;
            *)
                error "Unknown vision subcommand: ${2:-}"
                echo "Available: init" >&2
                echo "Run: zbuild vision --help" >&2
                exit 2
                ;;
        esac
        ;;
    docs)
        case "${2:-}" in
            generate)
                shift 2
                if [[ "${1:-}" == "--all" ]]; then
                    [[ $# -gt 1 ]] && { error "zbuild docs generate: --all cannot be combined with a source spec"; exit 2; }
                    # shellcheck source=lib/doc-generate.sh
                    source "$SCRIPT_DIR/lib/doc-generate.sh"
                    doc_generate_all
                else
                    [[ $# -eq 0 ]] && { error "zbuild docs generate: source spec required (plugin:<id> or mechanic:<name>)"; exit 2; }
                    # shellcheck source=lib/doc-generate.sh
                    source "$SCRIPT_DIR/lib/doc-generate.sh"
                    doc_generate_page "$1"
                fi
                ;;
            publish)
                shift 2
                # shellcheck source=lib/doc-publish.sh
                source "$SCRIPT_DIR/lib/doc-publish.sh"
                doc_publish_run "$@"
                ;;
            ""|-h|--help)
                cat <<'DOCSHELP'
zbuild docs — generate + publish wiki pages (DOC-D/DOC-F).

Sub-commands:
  generate <spec>   Generate a wiki page for a plugin or mechanic.
                    <spec> is 'plugin:<id>' or 'mechanic:<name>'.
  generate --all    Generate wiki pages for every plugin and every mechanic.
                    Processes all sources; reports failures without aborting early.
  publish           Regenerate all pages, refresh the README docs block, and push
                    docs/wiki/ to the project .wiki.git repo (release step, DOC-F).
                    Flags: --dry-run, --regen-only, --wiki-only, --version <v>.

Examples:
  zbuild docs generate plugin:plan
  zbuild docs generate mechanic:gather
  zbuild docs generate --all
  zbuild docs publish --dry-run
  zbuild docs publish --wiki-only --version v1.0.0.1
DOCSHELP
                ;;
            *)
                error "Unknown docs subcommand: ${2:-}"
                echo "Available: generate, publish" >&2
                echo "Run: zbuild docs --help" >&2
                exit 2
                ;;
        esac
        ;;
    *)
        error "Unknown command: $cmd"
        usage
        exit 2
        ;;
esac
