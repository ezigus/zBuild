+      - name: Surface persist result
+        # #1921: persist-result.json records why a snapshot was skipped/failed/pushed,
+        # but the file lives inside the artifact zip — operators must download it to
+        # learn the outcome. Surface the key fields as ::notice:: annotations so the
+        # reason is visible directly in the job log without downloading anything.
+        # find is used rather than a hardcoded path so a run that writes no state dir
+        # at all (early abort) simply produces a "not found" notice rather than an
+        # error. Fail-open: an absent file is not itself a failure.
+        if: always()
+        env:
+          ZBUILD_STATE_DIR: ${{ env.ZBUILD_STATE_DIR }}
+        run: |
+          result_file="$(find "${ZBUILD_STATE_DIR:-}" -name 'persist-result.json' -print -quit 2>/dev/null || true)"
+          if [[ -z "$result_file" ]]; then
+            echo "::notice::persist-result.json not found (run aborted before persist stage or state dir absent)"
+            exit 0
+          fi
+          verdict="$(jq -r '.verdict // empty' "$result_file" 2>/dev/null || true)"
+          snapshot="$(jq -r '.data.snapshot // empty' "$result_file" 2>/dev/null || true)"
+          pushed="$(jq -r '.data.pushed // empty' "$result_file" 2>/dev/null || true)"
+          reason="$(jq -r '.reason // empty' "$result_file" 2>/dev/null || true)"
+          echo "::notice::persist: verdict=${verdict:-?} snapshot=${snapshot:-?} pushed=${pushed:-?} reason=${reason:-?}"
+
+      - name: Delete stale test-residue state branch
+        # One-time cleanup: zbuild/state/issue-4244 was pushed by a pre-secret-gate
+        # version of persist-stage-test.sh. Idempotent — git push --delete exits 0
+        # when the ref is already absent (|| true catches the non-zero from a truly
+        # missing remote ref, which some git versions do return).
+        if: always()
+        run: |
+          git push --delete origin zbuild/state/issue-4244 2>/dev/null \
+            && echo "::notice::deleted stale test-residue branch zbuild/state/issue-4244" \
+            || true
+
       - name: Collect claude session transcripts (diagnostics)
         # #1728: a SIGTERM'd stage emits zero bytes into stage-io, so the
         # incrementally-written session JSONL is the only evidence of what the
