+_s17_vv_block="$(awk '/^  valid_verdicts:/{f=1;next} f && (/^  [^[:space:]-]/ || /^[^[:space:]]/){f=0} f{print}' "$_IMPACT_MF" 2>/dev/null || true)"
+for _s17_vv in "complete" "incomplete" "error"; do
