diff --git a/plugins/claim-coordinator/github-labels/tests/claim-coordinator-unit-test.sh b/plugins/claim-coordinator/github-labels/tests/claim-coordinator-unit-test.sh
index 409a41e9..05014db0 100755
--- a/plugins/claim-coordinator/github-labels/tests/claim-coordinator-unit-test.sh
+++ b/plugins/claim-coordinator/github-labels/tests/claim-coordinator-unit-test.sh
@@ -67,5 +67,265 @@ claim_coordinator_claim "99" 2>/dev/null
 set +e; claim_coordinator_heartbeat "99"; rc=$?; set -e
 assert_eq "claim_coordinator_heartbeat → rc=0" "0" "$rc"
 
+# ─────────────────────────────────────────────────────────────────────────────
+# DSCLA-1: zbuild_claim_acquire adds zbuild:claimed (not claimed:<machine>)
+# when no claim is present, and returns 0
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Given: local-fs backend, issue 1001 has no existing claim
+_dscla1_issue="1001"
+mkdir -p "$ZBUILD_CLAIM_STORE/$_dscla1_issue"
+# Ensure labels.txt is absent or empty
+rm -f "$ZBUILD_CLAIM_STORE/$_dscla1_issue/labels.txt"
+
+# Tight backoff so this test completes quickly
+export ZBUILD_CLAIM_BACKOFF_MIN_MS=5
+export ZBUILD_CLAIM_BACKOFF_MAX_MS=15
+
+export ZBUILD_RUN_ID="${ZBUILD_RUN_ID:-test-run-dscla1}"
+
+# When: zbuild_claim_acquire is called with the issue number
+: > "$ZBUILD_EVENTS_JSONL"
+set +e; zbuild_claim_acquire "$_dscla1_issue"; _dscla1_rc=$?; set -e
+
+# Then: function returns 0 (claim acquired)
+assert_eq "[DSCLA-1] zbuild_claim_acquire returns 0 (claim acquired)" "0" "$_dscla1_rc"
+
+# Then: the zbuild:claimed label is present on the issue
+_dscla1_lf="$ZBUILD_CLAIM_STORE/$_dscla1_issue/labels.txt"
+if grep -Fxq "zbuild:claimed" "$_dscla1_lf" 2>/dev/null; then
+    assert_pass "[DSCLA-1] zbuild:claimed label is present in claim store"
+else
+    assert_fail "[DSCLA-1] zbuild:claimed label is present in claim store" \
+        "$(cat "$_dscla1_lf" 2>/dev/null || echo '<file missing>')"
+fi
+
+# Then: the label is the constant zbuild:claimed with no hostname component
+if grep -q "^zbuild:claimed$" "$_dscla1_lf" 2>/dev/null; then
+    assert_pass "[DSCLA-1] label name is exactly zbuild:claimed (no hostname)"
+else
+    assert_fail "[DSCLA-1] label name is exactly zbuild:claimed (no hostname)" \
+        "$(cat "$_dscla1_lf" 2>/dev/null || echo '<file missing>')"
+fi
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DSCLA-2: claim comment names holder; label has no hostname
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Given: mock gh backend; set run_id and machine id
+_dscla2_issue="1002"
+_dscla2_calls="$TEST_TEMP_DIR/gh-calls-dscla2.txt"
+: > "$_dscla2_calls"
+
+# gh mock: records every invocation; returns empty labels for view; succeeds for edits/comments
+cat > "$TEST_TEMP_DIR/bin/gh" <<MOCK
+#!/usr/bin/env bash
+printf '%s\n' "\$@" >> "$_dscla2_calls"
+case "\${1:-}:\${2:-}:\${3:-}" in
+    issue:view:*)
+        # Return no labels (zbuild:claimed absent)
+        echo ""
+        ;;
+    issue:comment:*)
+        # Accept comment creation
+        echo "comment created"
+        ;;
+    issue:edit:*)
+        # Accept label edit
+        ;;
+    *)
+        ;;
+esac
+exit 0
+MOCK
+chmod +x "$TEST_TEMP_DIR/bin/gh"
+
+export ZBUILD_CLAIM_BACKEND="gh"
+export ZBUILD_RUN_ID="run-dscla2-123"
+export ZBUILD_CLAIM_MACHINE_ID="testmachine-dscla2"
+unset GITHUB_ACTIONS 2>/dev/null || true
+
+# When: zbuild_claim_acquire succeeds for the issue
+: > "$ZBUILD_EVENTS_JSONL"
+set +e; zbuild_claim_acquire "$_dscla2_issue"; _dscla2_rc=$?; set -e
+assert_eq "[DSCLA-2] zbuild_claim_acquire returns 0 (claim acquired via gh)" "0" "$_dscla2_rc"
+
+# Then: gh was called to add the label zbuild:claimed (not claimed:<machine>)
+if grep -q "zbuild:claimed" "$_dscla2_calls" 2>/dev/null; then
+    assert_pass "[DSCLA-2] gh called with zbuild:claimed label"
+else
+    assert_fail "[DSCLA-2] gh called with zbuild:claimed label" \
+        "calls recorded: $(cat "$_dscla2_calls" 2>/dev/null || echo '<empty>')"
+fi
+
+# Then: the label name is exactly zbuild:claimed — no hostname component
+if grep -Fq "claimed:" "$_dscla2_calls" 2>/dev/null && \
+   ! grep -Eq "claimed:[a-zA-Z0-9_-]" "$_dscla2_calls" 2>/dev/null; then
+    assert_pass "[DSCLA-2] label is zbuild:claimed with no extra hostname suffix"
+else
+    # Check explicitly: zbuild:claimed should appear; claimed:testmachine-dscla2 should NOT
+    if ! grep -qF "claimed:testmachine-dscla2" "$_dscla2_calls" 2>/dev/null; then
+        assert_pass "[DSCLA-2] label has no hostname component (machine-specific label not used)"
+    else
+        assert_fail "[DSCLA-2] label has no hostname component (machine-specific label not used)" \
+            "hostname-specific label found: $(grep -oE 'claimed:[a-zA-Z0-9_-]+' "$_dscla2_calls" 2>/dev/null || echo '<none>')"
+    fi
+fi
+
+# Then: a comment was posted containing run_id and machine name
+_dscla2_comment_body=""
+if grep -q "comment" "$_dscla2_calls" 2>/dev/null; then
+    _dscla2_comment_body="$(cat "$_dscla2_calls")"
+    assert_pass "[DSCLA-2] gh issue comment was called"
+else
+    assert_fail "[DSCLA-2] gh issue comment was called" \
+        "no comment call recorded in: $(cat "$_dscla2_calls" 2>/dev/null)"
+fi
+
+if grep -q "run-dscla2-123" "$_dscla2_calls" 2>/dev/null; then
+    assert_pass "[DSCLA-2] comment contains run_id"
+else
+    assert_fail "[DSCLA-2] comment contains run_id" \
+        "run_id 'run-dscla2-123' not found in gh calls: $(cat "$_dscla2_calls" 2>/dev/null)"
+fi
+
+if grep -q "testmachine-dscla2" "$_dscla2_calls" 2>/dev/null; then
+    assert_pass "[DSCLA-2] comment contains machine name"
+else
+    assert_fail "[DSCLA-2] comment contains machine name" \
+        "machine 'testmachine-dscla2' not found in gh calls: $(cat "$_dscla2_calls" 2>/dev/null)"
+fi
+
+# DSCLA-2 (CI sub-case): CI run URL when GITHUB_ACTIONS=true
+
+# Given: gh backend with GITHUB_ACTIONS=true; run URL variables set
+_dscla2b_issue="1002b"
+_dscla2b_calls="$TEST_TEMP_DIR/gh-calls-dscla2b.txt"
+: > "$_dscla2b_calls"
+cat > "$TEST_TEMP_DIR/bin/gh" <<MOCK
+#!/usr/bin/env bash
+printf '%s\n' "\$@" >> "$_dscla2b_calls"
+case "\${1:-}:\${2:-}:\${3:-}" in
+    issue:view:*) echo "" ;;
+    *) ;;
+esac
+exit 0
+MOCK
+chmod +x "$TEST_TEMP_DIR/bin/gh"
+
+export GITHUB_ACTIONS=true
+export GITHUB_RUN_ID="99887766"
+export GITHUB_SERVER_URL="https://github.com"
+export GITHUB_REPOSITORY="testowner/testrepo"
+
+# When: zbuild_claim_acquire is called with the issue number
+: > "$ZBUILD_EVENTS_JSONL"
+set +e; zbuild_claim_acquire "$_dscla2b_issue"; _dscla2b_rc=$?; set -e
+
+# Then: function returns 0 (claim acquired)
+assert_eq "[DSCLA-2] zbuild_claim_acquire returns 0 (CI mode)" "0" "$_dscla2b_rc"
+
+# Then: comment contains CI run URL information
+if grep -q "99887766" "$_dscla2b_calls" 2>/dev/null || \
+   grep -q "testowner/testrepo" "$_dscla2b_calls" 2>/dev/null; then
+    assert_pass "[DSCLA-2] comment contains CI run URL information when GITHUB_ACTIONS=true"
+else
+    assert_fail "[DSCLA-2] comment contains CI run URL information when GITHUB_ACTIONS=true" \
+        "CI info not found in: $(cat "$_dscla2b_calls" 2>/dev/null)"
+fi
+
+# Cleanup: restore CI environment variables
+unset GITHUB_ACTIONS GITHUB_RUN_ID GITHUB_SERVER_URL GITHUB_REPOSITORY 2>/dev/null || true
+
+# Restore local-fs backend for subsequent tests
+export ZBUILD_CLAIM_BACKEND="local-fs"
+# Restore a plain (non-recording) gh mock
+mock_gh
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DSCLA-3: zbuild_claim_acquire returns 1 when zbuild:claimed is present
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Given: zbuild:claimed is already on the issue
+_dscla3_issue="1003"
+mkdir -p "$ZBUILD_CLAIM_STORE/$_dscla3_issue"
+printf 'zbuild:claimed\n' > "$ZBUILD_CLAIM_STORE/$_dscla3_issue/labels.txt"
+
+# When: zbuild_claim_acquire is called
+: > "$ZBUILD_EVENTS_JSONL"
+set +e; zbuild_claim_acquire "$_dscla3_issue"; _dscla3_rc=$?; set -e
+
+# Then: it returns 1
+assert_eq "[DSCLA-3] zbuild_claim_acquire returns 1 when zbuild:claimed is present" "1" "$_dscla3_rc"
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DSCLA-4: _ZBUILD_CLAIM_HOLDER is set from the holder's claim comment body
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Given: zbuild:claimed on the issue and a claim comment with the marker exists
+_dscla4_issue="1004"
+mkdir -p "$ZBUILD_CLAIM_STORE/$_dscla4_issue"
+printf 'zbuild:claimed\n' > "$ZBUILD_CLAIM_STORE/$_dscla4_issue/labels.txt"
+# Holder info stored in the claim store for local-fs backend
+printf 'run-holder-99 on machine-other\n' > "$ZBUILD_CLAIM_STORE/$_dscla4_issue/holder.txt"
+
+# When: zbuild_claim_acquire is called and finds the label present
+unset _ZBUILD_CLAIM_HOLDER 2>/dev/null || true
+: > "$ZBUILD_EVENTS_JSONL"
+set +e; zbuild_claim_acquire "$_dscla4_issue"; _dscla4_rc=$?; set -e
+
+# Then: it returns 1
+assert_eq "[DSCLA-4] zbuild_claim_acquire returns 1 (already claimed)" "1" "$_dscla4_rc"
+
+# Then: _ZBUILD_CLAIM_HOLDER is set to the holder string from the claim store
+if [[ -n "${_ZBUILD_CLAIM_HOLDER:-}" ]]; then
+    assert_pass "[DSCLA-4] _ZBUILD_CLAIM_HOLDER is set (not empty)"
+else
+    assert_fail "[DSCLA-4] _ZBUILD_CLAIM_HOLDER is set (not empty)" \
+        "_ZBUILD_CLAIM_HOLDER was empty or unset"
+fi
+
+if grep -q "run-holder-99" <<< "${_ZBUILD_CLAIM_HOLDER:-}"; then
+    assert_pass "[DSCLA-4] _ZBUILD_CLAIM_HOLDER contains holder string from claim comment"
+else
+    assert_fail "[DSCLA-4] _ZBUILD_CLAIM_HOLDER contains holder string from claim comment" \
+        "_ZBUILD_CLAIM_HOLDER='${_ZBUILD_CLAIM_HOLDER:-}' (expected to contain 'run-holder-99')"
+fi
+
+# ─────────────────────────────────────────────────────────────────────────────
+# DSCLA-8: empty issue argument → no gh call, returns 0
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Given: mock gh that records calls
+_dscla8_calls="$TEST_TEMP_DIR/gh-calls-dscla8.txt"
+: > "$_dscla8_calls"
+cat > "$TEST_TEMP_DIR/bin/gh" <<MOCK
+#!/usr/bin/env bash
+printf '%s\n' "\$@" >> "$_dscla8_calls"
+exit 0
+MOCK
+chmod +x "$TEST_TEMP_DIR/bin/gh"
+
+# Switch to gh backend to verify no calls are made
+_prev_backend="$ZBUILD_CLAIM_BACKEND"
+export ZBUILD_CLAIM_BACKEND="gh"
+
+# When: zbuild_claim_acquire is called with an empty issue argument
+unset _ZBUILD_CLAIM_HOLDER 2>/dev/null || true
+: > "$ZBUILD_EVENTS_JSONL"
+set +e; zbuild_claim_acquire ""; _dscla8_rc=$?; set -e
+
+# Then: no gh label call is made
+_dscla8_call_count="$(wc -l < "$_dscla8_calls" | tr -d ' ')"
+assert_eq "[DSCLA-8] no gh calls made for empty issue" "0" "$_dscla8_call_count"
+
+# Then: function returns 0
+assert_eq "[DSCLA-8] zbuild_claim_acquire returns 0 for empty issue" "0" "$_dscla8_rc"
+
+# Cleanup: restore previous backend and plain gh mock
+export ZBUILD_CLAIM_BACKEND="$_prev_backend"
+mock_gh
+
 cleanup_test_env
 print_test_results
+exit $((FAIL > 0))
diff --git a/tests/integration/teardown-repeat-signal-test.sh b/tests/integration/teardown-repeat-signal-test.sh
index b4950da7..60a2e52e 100644
--- a/tests/integration/teardown-repeat-signal-test.sh
+++ b/tests/integration/teardown-repeat-signal-test.sh
@@ -135,5 +135,308 @@ assert_file_exists "[T4b] persist runs under repeated TERM" "$PERSISTED"
 assert_eq "[T5] the stage is not run again" "1" "$(grep -c x "$STARTS")"
 [[ "$_storm_rc" == 1 && -e "$PERSISTED" ]] || tail -15 "$TEST_TEMP_DIR/storm.out" >&2
 
+# ─── DSCLA-5, DSCLA-6, DSCLA-7, DSCLA-9: cross-machine claim (ADR-005) ──────
+#
+# Verifies that runner.sh:
+#   DSCLA-5: releases zbuild:claimed on normal pipeline exit
+#   DSCLA-6: releases zbuild:claimed on pipeline failure exit
+#   DSCLA-7: releases zbuild:claimed on TERM signal
+#   DSCLA-9: outputs the holder string when refusing a claimed issue
+#
+# These tests FAIL on the code from before this change because runner.sh
+# never calls zbuild_claim_acquire, so zbuild:claimed is never added to the
+# claim store during a run.  The mid-run claim-present marker is therefore
+# never written, and the assertion fails.
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Claim-test infrastructure: one repo shared across all four scenarios.
+_CLAIM_REPO="$(setup_git_temp_repo claim-dscla)"
+mkdir -p "$_CLAIM_REPO/.zbuild/templates"
+cat > "$_CLAIM_REPO/.zbuild/templates/claim-test.yaml" <<'CLAIMTPL'
+id: claim-test
+extends: simple
+flow:
+  - outcome
+always_run: []
+outcome:
+  gate: auto
+CLAIMTPL
+(cd "$_CLAIM_REPO" && git add .zbuild && git commit -qm "add claim-test template") \
+    >/dev/null 2>&1
+
+mock_plugin_factory outcome agent 0 >/dev/null
+
+export ZBUILD_CLAIM_BACKEND="local-fs"
+export ZBUILD_CLAIM_STORE="$TEST_TEMP_DIR/claim-store-dscla"
+export ZBUILD_CLAIM_BACKOFF_MIN_MS=5
+export ZBUILD_CLAIM_BACKOFF_MAX_MS=15
+export ZBUILD_NO_WORKTREE=1
+export ZBUILD_NO_ISSUE_LOCK=1
+mkdir -p "$ZBUILD_CLAIM_STORE"
+
+_SRL="$REPO_ROOT/scripts/lib/stage-result.sh"
+
+# ── Helper: prepare a fresh state+events dir for one claim scenario ──────────
+_claim_prep() {
+    local _label="$1"
+    _CDIR="$TEST_TEMP_DIR/cscenario-$_label"
+    mkdir -p "$_CDIR/state" "$_CDIR/events"
+    export ZBUILD_STATE_DIR="$_CDIR/state"
+    export ZBUILD_EVENTS_DIR="$_CDIR/events"
+    export ZBUILD_EVENTS_JSONL="$_CDIR/events/events.jsonl"
+}
+
+# ── DSCLA-5: zbuild:claimed released on normal pipeline completion ────────────
+
+# Given: the claim was acquired at run start (issue 90001764)
+_DSCLA5_ISSUE="90001764"
+_DSCLA5_PRESENT="$TEST_TEMP_DIR/dscla5-claim-present"
+_DSCLA5_STARTED="$TEST_TEMP_DIR/dscla5-stage-started"
+rm -f "$_DSCLA5_PRESENT" "$_DSCLA5_STARTED"
+
+# Stage: checks for zbuild:claimed before writing result; completes normally
+cat > "$PLUGINS_ROOT/agent/outcome/plugin.sh" <<PLUG
+outcome_run() {
+    # Check if zbuild:claimed is present before stage does any work [DSCLA-1]
+    if grep -Fxq "zbuild:claimed" "$ZBUILD_CLAIM_STORE/$_DSCLA5_ISSUE/labels.txt" 2>/dev/null; then
+        : > "$_DSCLA5_PRESENT"
+    fi
+    : > "$_DSCLA5_STARTED"
+    local _art; _art="\${ZBUILD_ARTIFACT_DIR:-\$(dirname "\$2")/artifacts}"; mkdir -p "\$_art"
+    source "$_SRL"
+    stage_result_write "\$_art/outcome-result.json" "pass" "claim check ok"
+    return 0
+}
+PLUG
+
+_claim_prep "dscla5"
+
+# When: the pipeline exits normally (_runner_ended=true)
+( cd "$_CLAIM_REPO" && exec bash "$RUNNER" \
+    --issue "$_DSCLA5_ISSUE" --no-resume \
+    --template claim-test ) \
+    > "$TEST_TEMP_DIR/dscla5.out" 2>&1
+_dscla5_rc=$?
+
+# Then: zbuild:claimed was present on the issue before the first stage ran
+if [[ -e "$_DSCLA5_PRESENT" ]]; then
+    assert_pass "[DSCLA-1/5] zbuild:claimed was present before the first stage dispatched"
+else
+    assert_fail "[DSCLA-1/5] zbuild:claimed was present before the first stage dispatched" \
+        "claim never appeared in store; rc=$_dscla5_rc output=$(tail -5 "$TEST_TEMP_DIR/dscla5.out")"
+fi
+
+# Then: zbuild:claimed is absent from the issue after normal exit
+# (gate on acquisition: if the claim was never added, release cannot be verified)
+if [[ ! -e "$_DSCLA5_PRESENT" ]]; then
+    assert_fail "[DSCLA-5] zbuild:claimed was never acquired — cannot verify release" \
+        "claim never appeared in store; rc=$_dscla5_rc output=$(tail -5 "$TEST_TEMP_DIR/dscla5.out")"
+elif ! grep -Fxq "zbuild:claimed" "$ZBUILD_CLAIM_STORE/$_DSCLA5_ISSUE/labels.txt" 2>/dev/null; then
+    assert_pass "[DSCLA-5] zbuild:claimed absent after normal pipeline completion"
+else
+    assert_fail "[DSCLA-5] zbuild:claimed absent after normal pipeline completion" \
+        "label still present in claim store after runner exit"
+fi
+
+# Then: the claim comment body shows finished status
+_dscla5_comment="$ZBUILD_CLAIM_STORE/$_DSCLA5_ISSUE/comment.txt"
+if grep -qi "finished" "$_dscla5_comment" 2>/dev/null; then
+    assert_pass "[DSCLA-5] claim comment body shows finished status after normal exit"
+else
+    assert_fail "[DSCLA-5] claim comment body shows finished status after normal exit" \
+        "comment: $(cat "$_dscla5_comment" 2>/dev/null || echo '<not found>')"
+fi
+
+# ── DSCLA-6: zbuild:claimed released on pipeline failure ─────────────────────
+
+# Given: the claim was acquired at run start (issue 90001765)
+_DSCLA6_ISSUE="90001765"
+_DSCLA6_PRESENT="$TEST_TEMP_DIR/dscla6-claim-present"
+rm -f "$_DSCLA6_PRESENT"
+
+# Stage: checks for zbuild:claimed, then fails (stage failure triggers abort)
+cat > "$PLUGINS_ROOT/agent/outcome/plugin.sh" <<PLUG
+outcome_run() {
+    if grep -Fxq "zbuild:claimed" "$ZBUILD_CLAIM_STORE/$_DSCLA6_ISSUE/labels.txt" 2>/dev/null; then
+        : > "$_DSCLA6_PRESENT"
+    fi
+    local _art; _art="\${ZBUILD_ARTIFACT_DIR:-\$(dirname "\$2")/artifacts}"; mkdir -p "\$_art"
+    source "$_SRL"
+    stage_result_write "\$_art/outcome-result.json" "broken" "deliberate failure"
+    return 1
+}
+PLUG
+
+_claim_prep "dscla6"
+
+# When: the pipeline exits due to a stage failure (_runner_abort_trap fires)
+( cd "$_CLAIM_REPO" && exec bash "$RUNNER" \
+    --issue "$_DSCLA6_ISSUE" --no-resume \
+    --template claim-test ) \
+    > "$TEST_TEMP_DIR/dscla6.out" 2>&1
+_dscla6_rc=$?
+
+# Then: zbuild:claimed was present before the stage ran
+if [[ -e "$_DSCLA6_PRESENT" ]]; then
+    assert_pass "[DSCLA-6] zbuild:claimed was present during failure run"
+else
+    assert_fail "[DSCLA-6] zbuild:claimed was present during failure run" \
+        "claim never appeared in store; rc=$_dscla6_rc output=$(tail -5 "$TEST_TEMP_DIR/dscla6.out")"
+fi
+
+# Then: zbuild:claimed is absent after failure exit
+# (gate on acquisition: if the claim was never added, release cannot be verified)
+if [[ ! -e "$_DSCLA6_PRESENT" ]]; then
+    assert_fail "[DSCLA-6] zbuild:claimed was never acquired — cannot verify release" \
+        "claim never appeared in store; rc=$_dscla6_rc output=$(tail -5 "$TEST_TEMP_DIR/dscla6.out")"
+elif ! grep -Fxq "zbuild:claimed" "$ZBUILD_CLAIM_STORE/$_DSCLA6_ISSUE/labels.txt" 2>/dev/null; then
+    assert_pass "[DSCLA-6] zbuild:claimed absent after pipeline failure"
+else
+    assert_fail "[DSCLA-6] zbuild:claimed absent after pipeline failure" \
+        "label still present after failure exit"
+fi
+
+# Then: the claim comment body shows finished status
+_dscla6_comment="$ZBUILD_CLAIM_STORE/$_DSCLA6_ISSUE/comment.txt"
+if grep -qi "finished" "$_dscla6_comment" 2>/dev/null; then
+    assert_pass "[DSCLA-6] claim comment body shows finished status after failure exit"
+else
+    assert_fail "[DSCLA-6] claim comment body shows finished status after failure exit" \
+        "comment: $(cat "$_dscla6_comment" 2>/dev/null || echo '<not found>')"
+fi
+
+# ── DSCLA-7: zbuild:claimed released on TERM signal ──────────────────────────
+
+# Given: the claim was acquired at run start (issue 90001766)
+_DSCLA7_ISSUE="90001766"
+_DSCLA7_PRESENT="$TEST_TEMP_DIR/dscla7-claim-present"
+_DSCLA7_STARTED="$TEST_TEMP_DIR/dscla7-stage-started"
+rm -f "$_DSCLA7_PRESENT" "$_DSCLA7_STARTED"
+
+# Stage: checks for zbuild:claimed, writes marker, then sleeps (waits for TERM)
+cat > "$PLUGINS_ROOT/agent/outcome/plugin.sh" <<PLUG
+outcome_run() {
+    if grep -Fxq "zbuild:claimed" "$ZBUILD_CLAIM_STORE/$_DSCLA7_ISSUE/labels.txt" 2>/dev/null; then
+        : > "$_DSCLA7_PRESENT"
+    fi
+    : > "$_DSCLA7_STARTED"
+    sleep 60
+    local _art; _art="\${ZBUILD_ARTIFACT_DIR:-\$(dirname "\$2")/artifacts}"; mkdir -p "\$_art"
+    source "$_SRL"
+    stage_result_write "\$_art/outcome-result.json" "pass" "claim check ok"
+    return 0
+}
+PLUG
+
+_claim_prep "dscla7"
+
+# When: the runner process receives SIGTERM (_runner_signal_trap then _runner_abort_trap)
+( cd "$_CLAIM_REPO" && exec bash "$RUNNER" \
+    --issue "$_DSCLA7_ISSUE" --no-resume \
+    --template claim-test ) \
+    > "$TEST_TEMP_DIR/dscla7.out" 2>&1 &
+_DSCLA7_PID=$!
+
+# Wait for the stage to have started (which means claim was acquired before it)
+for _ in $(seq 1 300); do [[ -e "$_DSCLA7_STARTED" ]] && break; sleep 0.1; done
+
+kill -TERM "$_DSCLA7_PID" 2>/dev/null || true
+for _ in $(seq 1 300); do kill -0 "$_DSCLA7_PID" 2>/dev/null || break; sleep 0.1; done
+kill -KILL "$_DSCLA7_PID" 2>/dev/null || true
+wait "$_DSCLA7_PID" 2>/dev/null || true
+
+if [[ ! -e "$_DSCLA7_STARTED" ]]; then
+    assert_fail "[setup-DSCLA-7] stage started before TERM" \
+        "$(tail -10 "$TEST_TEMP_DIR/dscla7.out")"
+fi
+
+# Then: zbuild:claimed was present before the stage ran
+if [[ -e "$_DSCLA7_PRESENT" ]]; then
+    assert_pass "[DSCLA-7] zbuild:claimed was present before stage started"
+else
+    assert_fail "[DSCLA-7] zbuild:claimed was present before stage started" \
+        "claim never appeared in store"
+fi
+
+# Then: zbuild:claimed is absent after TERM exit
+# (gate on acquisition: if the claim was never added, release cannot be verified)
+if [[ ! -e "$_DSCLA7_PRESENT" ]]; then
+    assert_fail "[DSCLA-7] zbuild:claimed was never acquired — cannot verify release after TERM" \
+        "claim never appeared in store"
+elif ! grep -Fxq "zbuild:claimed" "$ZBUILD_CLAIM_STORE/$_DSCLA7_ISSUE/labels.txt" 2>/dev/null; then
+    assert_pass "[DSCLA-7] zbuild:claimed absent after TERM signal"
+else
+    assert_fail "[DSCLA-7] zbuild:claimed absent after TERM signal" \
+        "label still present after TERM"
+fi
+
+# Then: the claim comment body shows finished status
+_dscla7_comment="$ZBUILD_CLAIM_STORE/$_DSCLA7_ISSUE/comment.txt"
+if grep -qi "finished" "$_dscla7_comment" 2>/dev/null; then
+    assert_pass "[DSCLA-7] claim comment body shows finished status after TERM signal"
+else
+    assert_fail "[DSCLA-7] claim comment body shows finished status after TERM signal" \
+        "comment: $(cat "$_dscla7_comment" 2>/dev/null || echo '<not found>')"
+fi
+
+# ── DSCLA-9: runner output contains holder string when zbuild:claimed present ─
+
+# Given: zbuild:claimed on the issue and a claim comment with a holder string
+_DSCLA9_ISSUE="90001767"
+_DSCLA9_HOLDER="run-holder-9abc on machine-other"
+_DSCLA9_STARTED="$TEST_TEMP_DIR/dscla9-stage-started"
+rm -f "$_DSCLA9_STARTED"
+
+# Pre-populate the claim store: label + holder
+mkdir -p "$ZBUILD_CLAIM_STORE/$_DSCLA9_ISSUE"
+printf 'zbuild:claimed\n' > "$ZBUILD_CLAIM_STORE/$_DSCLA9_ISSUE/labels.txt"
+printf '%s\n' "$_DSCLA9_HOLDER" > "$ZBUILD_CLAIM_STORE/$_DSCLA9_ISSUE/holder.txt"
+
+# Stage: writes marker if dispatched (must NOT be dispatched for DSCLA-9 to pass)
+cat > "$PLUGINS_ROOT/agent/outcome/plugin.sh" <<PLUG
+outcome_run() {
+    : > "$_DSCLA9_STARTED"
+    local _art; _art="\${ZBUILD_ARTIFACT_DIR:-\$(dirname "\$2")/artifacts}"; mkdir -p "\$_art"
+    source "$_SRL"
+    stage_result_write "\$_art/outcome-result.json" "pass" "should not reach here"
+    return 0
+}
+PLUG
+
+_claim_prep "dscla9"
+
+# When: the runner is started on that issue
+( cd "$_CLAIM_REPO" && exec bash "$RUNNER" \
+    --issue "$_DSCLA9_ISSUE" --no-resume \
+    --template claim-test ) \
+    > "$TEST_TEMP_DIR/dscla9.out" 2>&1
+_dscla9_rc=$?
+
+# Then: the runner's stdout or stderr output contains the holder string
+if grep -qF "$_DSCLA9_HOLDER" "$TEST_TEMP_DIR/dscla9.out" 2>/dev/null; then
+    assert_pass "[DSCLA-9] runner output contains holder string when zbuild:claimed is present"
+else
+    assert_fail "[DSCLA-9] runner output contains holder string when zbuild:claimed is present" \
+        "holder '$_DSCLA9_HOLDER' not found in: $(cat "$TEST_TEMP_DIR/dscla9.out" 2>/dev/null)"
+fi
+
+# Then: runner exits non-zero before any stage is dispatched
+if [[ "$_dscla9_rc" -ne 0 ]]; then
+    assert_pass "[DSCLA-9] runner exits non-zero when zbuild:claimed is present"
+else
+    assert_fail "[DSCLA-9] runner exits non-zero when zbuild:claimed is present" \
+        "runner exited 0 (should have refused)"
+fi
+
+if [[ ! -e "$_DSCLA9_STARTED" ]]; then
+    assert_pass "[DSCLA-9] no stage was dispatched when runner refused the claim"
+else
+    assert_fail "[DSCLA-9] no stage was dispatched when runner refused the claim" \
+        "stage started marker found — runner dispatched a stage after refusing"
+fi
+
+# ─────────────────────────────────────────────────────────────────────────────
+# End of DSCLA claim tests
+# ─────────────────────────────────────────────────────────────────────────────
 print_test_results
 exit $((FAIL > 0))
