@@ -2451,6 +2453,20 @@ main() {
             return 1
         fi
     fi
+    # Cross-machine soft claim via zbuild:claimed GitHub label (ADR-005 / #1764).
+    # Runs after the intra-machine flock so the intra-machine guard still wins.
+    if declare -F zbuild_claim_acquire >/dev/null 2>&1; then
