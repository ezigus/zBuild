+# Mirrors _plan_budget_guidance from plugins/agent/plan/plugin.sh.
+_design_budget_guidance() {
+    local budget="${1:-}"
+    [[ "$budget" =~ ^[0-9]+$ && "$budget" -gt 0 ]] || { printf ''; return 0; }
+    cat <<EOF
