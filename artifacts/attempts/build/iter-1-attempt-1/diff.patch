+assert_eq "[SPEC-17] state_file-absent rc in {0,1}" "1" "$(( _sfabs_rc != 2 ? 1 : 0 ))"
+assert_eq "[SPEC-17] dry-run rc in {0,1}" "1" "$(( _s_dry_rc != 2 ? 1 : 0 ))"
