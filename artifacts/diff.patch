     if [[ -z "$diff_text" ]]; then
         printf '{"result_contract":2,"verdict":"skip","disposition":"complete","reason":"empty_diff","baseline":"%s","finding_count":0,"findings":[]}\n' "$base" \
             | atomic_write "$result_path"
