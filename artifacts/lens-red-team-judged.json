{"lens":{"fp":"2359231390-24801","payload":"{\n  \"score\": 5,\n  \"findings\": [\n    {\n      \"file\": \"core/pipeline/runner.sh\",\n      \"category\": \"logic\",\n      \"severity\": \"high\",\n      \"message\": \"After zbuild_claim_acquire succeeds, the two early-failure return paths — _runner_enter_worktree failure and zbuild_run_branch_setup failure — call only zbuild_run_cap_release and return before the EXIT trap is installed (line 2940), so zbuild_claim_release is never called; the zbuild:claimed label stays on the issue permanently until removed by hand.\",\n      \"quote\": \"if ! _runner_enter_worktree \\\"$state_dir\\\" \\\"$_runner_run_id\\\" \\\"$_wt_key\\\"; then\\n        zbuild_run_cap_release || true\\n        return 1\\n    fi\",\n      \"trigger\": \"A network outage or git error causes _runner_enter_worktree or zbuild_run_branch_setup to fail on a run that already acquired the claim; the process exits with no EXIT trap set, the label stays, and every subsequent run on the same issue is refused until an operator removes the label by hand.\",\n      \"introduced\": true,\n      \"fix\": \"code\"\n    },\n    {\n      \"file\": \"core/claim/claim.sh\",\n      \"category\": \"injection\",\n      \"severity\": \"medium\",\n      \"message\": \"_ccgl_read_holder selects the last GitHub comment that contains the substring <!-- zbuild-run-status and extracts whatever the zbuild-holder field says; any user who can comment on the issue can craft a comment that becomes the most-recent match, injecting attacker-controlled content into the error message printed to the operator's terminal.\",\n      \"quote\": \"body=\\\"$(gh issue comment list \\\"$issue\\\" --json body \\\\\\n                --jq '[.[] | select(.body | contains(\\\"<!-- zbuild-run-status\\\")) | .body] | last' \\\\\\n                2>/dev/null || true)\\\"\",\n      \"trigger\": \"An outside actor posts a comment on the issue whose body contains the string <!-- zbuild-run-status and a crafted <!-- zbuild-holder: EVIL --> line; the next refused run prints the crafted string verbatim (including terminal escape codes) in the error logged to the operator's shell.\",\n      \"introduced\": true,\n      \"fix\": \"code\"\n    },\n    {\n      \"file\": \"plugins/claim-coordinator/github-labels/plugin.sh\",\n      \"category\": \"logic\",\n      \"severity\": \"low\",\n      \"message\": \"Despite the design decision explicitly stating 'plugin.sh must not source core/claim/claim.sh — that would create a circular dependency and add a startup $(cd …) subshell in plugin.sh's load path', the change adds exactly that at the bottom of plugin.sh; the || true guard silently swallows a cd failure and lets pwd produce the working directory, so the resolved path and hence the sourced claim.sh would be wrong whenever BASH_SOURCE[0] is empty.\",\n      \"quote\": \"_ccgl_plugin_dir=\\\"$(cd \\\"${BASH_SOURCE[0]%/*}\\\" 2>/dev/null || true; pwd)\\\"\",\n      \"trigger\": \"plugin.sh is sourced in a context where BASH_SOURCE[0] is empty (eval, process substitution, or any non-file source path); cd silently fails, pwd returns the current working directory, and the constructed path ../../../core/claim/claim.sh resolves relative to that directory instead of the plugin's location.\",\n      \"introduced\": true,\n      \"fix\": \"code\"\n    }\n  ]\n}","files":{"/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/plugin.sh":"2e2649a7ef6be6c9ab172921cc93401399968c6a","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/claim/claim.sh":"9c5e4918b9c2dd16c79aecbdd522a427e77449b0","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/pipeline/runner.sh":"2b3774255137a68541831d08a7a87f1f84962a5f"}},"scripts/lib/run-status-render.sh":{"fp":"216103334-25587:file:scripts/lib/run-status-render.sh","payload":"clean: no finding\n[]","files":{"/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/p