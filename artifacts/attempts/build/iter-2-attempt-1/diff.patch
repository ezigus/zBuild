 _startup_int="$(awk '/^main\(\) \{/{f=1} f && /trap .* INT$/{print; exit}' "$_runner_sh" \
     | grep -oE "trap '[^']+' INT" || true)"
-_startup_term="$(awk '/^main\(\) \{/{f=1} f && /trap .* TERM$/{print; exit}' "$_runner_sh" \
+_startup_term="$(awk '/^main\(\) \{/{f=1} f && /trap '"'"'.*'"'"' TERM$/{print; exit}' "$_runner_sh" \
