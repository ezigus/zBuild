diff --git a/plugins/tool/pr-open/lib/advisory-section.sh b/plugins/tool/pr-open/lib/advisory-section.sh
index b37f3808..826a0365 100644
--- a/plugins/tool/pr-open/lib/advisory-section.sh
+++ b/plugins/tool/pr-open/lib/advisory-section.sh
@@ -119,34 +119,68 @@ _pr_open_render_pre_existing_section() {
     fi
 }
 
+# _pr_open_render_convergence_section <convergence_json>
+# Renders a warning block for each unconverged cycle (status=max_iterations).
+# convergence_json is a JSON array of {cycle_id, iterations_used, max_iterations}.
+# Prints nothing when the array is empty or invalid.
+_pr_open_render_convergence_section() {
+    local convergence_json="${1:-[]}"
+    [[ -n "$convergence_json" && "$convergence_json" != "[]" ]] || return 0
+    jq -r '.[] | "> ⚠️ **\(.cycle_id) not converged** (\(.iterations_used)/\(.max_iterations) iterations). Opened as draft per ADR-019 fall-through."' \
+        <<< "$convergence_json" 2>/dev/null || true
+}
+
+# _pr_open_render_gate_section <gate_aggregator_path>
+# Renders failing gate names and reason from gate_aggregator_result when verdict=fail.
+# Prints nothing when the file is absent or verdict is not fail.
+_pr_open_render_gate_section() {
+    local gate_path="${1:-}"
+    [[ -f "$gate_path" ]] || return 0
+    local verdict
+    verdict="$(jq -r '.verdict // ""' "$gate_path" 2>/dev/null || true)"
+    [[ "$verdict" == "fail" ]] || return 0
+    local failed_gates reason
+    failed_gates="$(jq -r '.failed // [] | join(", ")' "$gate_path" 2>/dev/null || true)"
+    reason="$(jq -r '.reason // ""' "$gate_path" 2>/dev/null || true)"
+    printf 'Failing gates: %s.' "${failed_gates:-none}"
+    [[ -n "$reason" ]] && printf ' %s' "$reason"
+}
+
 # _pr_open_compose_body <issue> <plan_goal> <review_json> <review_verdict>
-#   <advisory_report> <test_verdict> — the PR body. #2301: findings the lenses
-# marked pre-existing get their own section, so every lens finding reaches the
-# PR (ADR-040 2026-10-05). The advisory block is followed by a BLANK line: it
-# can end in a closing </details>, and GitHub keeps consuming an HTML block
-# until one appears. It is added here, not inside the renderers, because the
-# command substitution strips every trailing newline they emit.
+#   <advisory_report> <test_verdict> [convergence_json] [gate_aggregator_path]
+# The PR body. #2301: findings the lenses marked pre-existing get their own
+# section. Args 7-8 carry convergence state and gate failure info (ADR-019).
+# The advisory block is followed by a BLANK line: it can end in a closing
+# </details>, and GitHub keeps consuming an HTML block until one appears. It is
+# added here, not inside the renderers, because the command substitution strips
+# every trailing newline they emit.
 _pr_open_compose_body() {
     local issue_num="$1" plan_summary="$2" review_json_path="$3" review_verdict="$4"
     local advisory_report="$5" test_verdict="$6"
-    local advisory_block pre_existing_section
+    local convergence_json="${7:-[]}" gate_aggregator_path="${8:-}"
+    local advisory_block pre_existing_section convergence_block gate_block
     advisory_block="**Advisory review (non-blocking, ADR-040):** $(_pr_open_render_advisory_section "$advisory_report")"
     pre_existing_section="$(_pr_open_render_pre_existing_section "$advisory_report")"
     if [[ -n "$pre_existing_section" ]]; then
         advisory_block+=$'\n\n'"**Already in the code before this change (not introduced here):** ${pre_existing_section}"
     fi
+    convergence_block="$(_pr_open_render_convergence_section "$convergence_json")"
+    gate_block="$(_pr_open_render_gate_section "$gate_aggregator_path")"
+    local _extra=""
+    [[ -n "$convergence_block" ]] && _extra+=$'\n\n'"$convergence_block"
+    [[ -n "$gate_block" ]] && _extra+=$'\n\n'"$gate_block"
     if [[ -f "$review_json_path" ]]; then
-        printf '%s\n\n%s\n%s\n%s\n%s\n\n%s\n%s\n%s' \
+        printf '%s\n\n%s\n%s\n%s\n%s\n\n%s\n%s\n%s%s' \
             "${issue_num:+Closes #${issue_num}}" "---" \
             "**Plan goal:** ${plan_summary:-N/A}" \
             "**Review verdict:** ${review_verdict:-N/A}" \
             "$advisory_block" "**Test verdict:** ${test_verdict:-N/A}" "" \
-            "Generated by zBuild automation."
+            "Generated by zBuild automation." "$_extra"
     else
-        printf '%s\n\n%s\n%s\n%s\n\n%s\n%s\n%s' \
+        printf '%s\n\n%s\n%s\n%s\n\n%s\n%s\n%s%s' \
             "${issue_num:+Closes #${issue_num}}" "---" \
             "**Plan goal:** ${plan_summary:-N/A}" \
             "$advisory_block" "**Test verdict:** ${test_verdict:-N/A}" "" \
-            "Generated by zBuild automation."
+            "Generated by zBuild automation." "$_extra"
     fi
 }
