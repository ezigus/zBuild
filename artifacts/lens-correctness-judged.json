f0f003c7692c1f3ce0","files":{}}},"core/claim/claim.sh":{"fp":"1390590844-25677:file:core/claim/claim.sh","payload":"found: findings\n[{\"file\":\"core/claim/claim.sh\",\"category\":\"logic\",\"severity\":\"medium\",\"message\":\"The JSON holder extraction in `zbuild_claim_acquire` uses `grep -o '\\\"holder\\\":[[:space:]]*\\\"[^\\\"]*\\\"'`; the `[^\\\"]*` class stops at the first `\\\"` character, so a holder whose JSON-escaped form contains `\\\\\\\"` (an escaped double-quote, written by `claim_coordinator_claim`'s `sed 's/\\\"/\\\\\\\\\\\"/g'`) is silently truncated — the regex matches only the bytes before the escaped quote.\",\"quote\":\"raw_holder=\\\"$(grep -o '\\\"holder\\\":[[:space:]]*\\\"[^\\\"]*\\\"' <<< \\\"$json_out\\\" || true)\\\"\",\"trigger\":\"A holder string containing a literal double-quote character (e.g. a machine name or run-id containing `\\\"`); `claim_coordinator_claim` JSON-escapes it to `\\\\\\\"`, but `[^\\\"]*` stops at the unescaped `\\\"` byte, returning a truncated `raw_holder` to the outer `sed` extraction, which then strips only up to the first `\\\"` it sees.\",\"accepted_if\":\"The holder string as printed in the run's refusal output is identical to the holder string embedded in the run-status comment's `<!-- zbuild-holder: -->` field, even when that string contains a double-quote character.\",\"introduced\":true,\"fix\":\"code\"}]","files":{"/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/claim/claim.sh":"707f8ea05518fe3845c2d8ef7b8912a5c2f36ccd","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/pipeline/runner.sh":"640b4c0571bfe697f236a515f95be55b18d805f9","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/tests/integration/teardown-repeat-signal-test.sh":"56412590fd176648fd2d3fb0fdeaf9acd1165c23","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/scripts/lib/run-status-render.sh":"e66946ae97fcf967c5f77ee2ea2518de3b7fda3b","/home/runner/.zbuild/repos/ezigus/zBuild/is