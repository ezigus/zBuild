+    else
+        assert_fail "[SPEC-18] artifacts_dir fallback: pr_url from artifacts_dir/pr-url.txt in deploy-result.json" \
+            "got pr_url='$_s18b_pr_url' — artifacts_dir fallback not working"
+    fi
+fi
