+
+_rc_bl=0; ( pr_open_run "pr" "$_sf_bl" ) >/dev/null 2>&1 || _rc_bl=$?
+
+assert_eq "[SPEC-6] pr_open_run blocked path returns rc=1 (not 2)" "1" "$_rc_bl"
+if [[ -f "$_art_bl/pr-result.json" ]]; then
