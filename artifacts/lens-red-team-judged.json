{"lens":{"fp":"2359231390-24801","payload":"{\n  \"score\": 5,\n  \"findings\": [\n    {\n      \"file\": \"core/pipeline/runner.sh\",\n      \"category\": \"logic\",\n      \"severity\": \"high\",\n      \"message\": \"After zbuild_claim_acquire succeeds, the two early-failure return paths — _runner_enter_worktree failure and zbuild_run_branch_setup failure — call only zbuild_run_cap_release and return before the EXIT trap is installed (line 2940), so zbuild_claim_release is never called; the zbuild:claimed label stays on the issue permanently until removed by hand.\",\n      \"quote\": \"if ! _runner_enter_worktree \\\"$state_dir\\\" \\\"$_runner_run_id\\\" \\\"$_wt_key\\\"; then\\n        zbuild_run_cap_release || true\\n        return 1\\n    fi\",\n      \"trigger\": \"A network outage or git error causes _runner_enter_worktree or zbuild_run_branch_setup to fail on a run that already acquired the claim; the process exits with no EXIT trap set, the label stays, and every subsequent run on the same issue is refused until an operator removes the label by hand.\",\n      \"introduced\": true,\n      \"fix\": \"code\"\n    },\n    {\n      \"file\": \"core/claim/claim.sh\",\n      \"category\": \"injection\",\n      \"severity\": \"medium\",\n      \"message\": \"_ccgl_read_holder selects the last GitHub comment that contains the substring <!-- zbuild-run-status and extracts whatever the zbuild-holder field says; any user who can comment on the issue can craft a comment that becomes the most-recent match, injecting attacker-controlled content into the error message printed to the operator's terminal.\",\n      \"quote\": \"body=\\\"$(gh issue comment list \\\"$issue\\\" --json body \\\\\\n                --jq '[.[] | select(.body | contains(\\\"<!-- zbuild-run-status\\\")) | .body] | last' \\\\\\n                2>/dev/null || true)\\\"\",\n      \"trigger\": \"An outside actor posts a comment on the issue whose body contains the string <!-- zbuild-run-status and a crafted <!-- zbuild-holder: EVIL --> line; the next refused run prints the crafted string verbatim (including terminal escape codes) in the error logged to the operator's shell.\",\n      \"introduced\": true,\n      \"fix\": \"code\"\n    },\n    {\n      \"file\": \"plugins/claim-coordinator/github-labels/plugin.sh\",\n      \"category\": \"logic\",\n      \"severity\": \"low\",\n      \"message\": \"Despite the design decision explicitly stating 'plugin.sh must not source core/claim/claim.sh — that would create a circular dependency and add a startup $(cd …) subshell in plugin.sh's load path', the change adds exactly that at the bottom of plugin.sh; the || true guard silently swallows a cd failure and lets pwd produce the working directory, so the resolved path and hence the sourced claim.sh would be wrong whenever BASH_SOURCE[0] is empty.\",\n      \"quote\": \"_ccgl_plugin_dir=\\\"$(cd \\\"${BASH_SOURCE[0]%/*}\\\" 2>/dev/null || true; pwd)\\\"\",\n      \"trigger\": \"plugin.sh is sourced in a context where BASH_SOURCE[0] is empty (eval, process substitution, or any non-file source path); cd silently fails, pwd returns the current working directory, and the constructed path ../../../core/claim/claim.sh resolves relative to that directory instead of the plugin's location.\",\n      \"introduced\": true,\n      \"fix\": \"code\"\n    }\n  ]\n}","files":{"/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/plugin.sh":"2e2649a7ef6be6c9ab172921cc93401399968c6a","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/claim/claim.sh":"9c5e4918b9c2dd16c79aecbdd522a427e77449b0","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/pipeline/runner.sh":"2b3774255137a68541831d08a7a87f1f84962a5f"}},"scripts/lib/run-status-render.sh":{"fp":"2623001574-25847:file:scripts/lib/run-status-render.sh","payload":"clean: no finding\n[]","files":{"/home/runner/.claude/projects/-home-runner--zbuild-repos-ezigus-zBuild-issues-1764-worktree/65956d28-db2f-4c14-bb1b-fd9a6885573a/tool-results/bqmlwj47r.txt":"ea9f07e55ebb11e1e64e149cf688b89e448f4d8a","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/claim/claim.sh":"707f8ea05518fe3845c2d8ef7b8912a5c2f36ccd","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/pipeline/runner.sh":"640b4c0571bfe697f236a515f95be55b18d805f9","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/plugin.sh":"70e7aca83387ee35ec149c1cdf06100c46f089f8","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core":"tree:65e4a48c66a9284bb91ee1fd0fd7d6c041ea2fd9","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/event-bus/event-bus.sh":"61462a1a2cdd0ba3cdf09591604fd78a7e9ac15f","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/tests/claim-coordinator-unit-test.sh":"fcfe016bb086517ecb46b0a27f44360b8f5eb5f5","/home/runner/.claude/projects/-home-runner--zbuild-repos-ezigus-zBuild-issues-1764-worktree/65956d28-db2f-4c14-bb1b-fd9a6885573a/tool-results/bm9vdnesm.txt":"7ecd4394e30fa79bcbc4ebd10c55f97f5ca0177e","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/scripts/lib/run-status-render.sh":"e66946ae97fcf967c5f77ee2ea2518de3b7fda3b"},"base":{"head":"3300f9f9aacc51ab294412f0f003c7692c1f3ce0","files":{}}},"core/claim/claim.sh":{"fp":"2623001574-25847:file:core/claim/claim.sh","payload":"found: findings\n[{\"file\":\"core/claim/claim.sh\",\"category\":\"injection\",\"severity\":\"medium\",\"message\":\"The sed pattern that sanitizes the holder string strips only CSI SGR (m) and EL (K) sequences, leaving cursor-movement, clear-screen, cursor-position, and OSC sequences intact, so those bytes reach the operator's terminal via printf '%s\\\\n' and are executed as terminal control sequences.\",\"quote\":\"holder_value=\\\"$(sed -e 's/^\\\"holder\\\":[[:space:]]*\\\"\\\\(.*\\\\)\\\"$/\\\\1/' \\\\\\n            -e 's/\\\\x1b\\\\[[0-9;]*[mK]//g' <<< \\\"$raw_holder\\\" || true)\\\"\",\"trigger\":\"An attacker who can post a crafted holder comment includes a sequence such as '\\\\x1b[2J' (clear screen) or '\\\\x1b]0;evil\\\\x07' (window-title injection) in the holder string. The sed pattern does not match these sequences because their terminators are not 'm' or 'K', so they survive into _ZBUILD_CLAIM_HOLDER and are written verbatim to the operator's terminal when the refused run calls printf '%s\\\\n' \\\"${_ZBUILD_CLAIM_HOLDER:-unknown}\\\" >&2.\",\"accepted_if\":\"The holder string passed to printf '%s\\\\n' on refusal contains no terminal control sequences — meaning the sanitization applied to the extracted holder before it is stored in _ZBUILD_CLAIM_HOLDER strips all CSI sequences (any letter terminator) and all bare-ESC-prefixed sequences, at minimum matching the coverage of the event-bus's _eb_strip_ansi pattern.\",\"introduced\":true,\"fix\":\"code\"}]","files":{"/home/runner/.claude/projects/-home-runner--zbuild-repos-ezigus-zBuild-issues-1764-worktree/65956d28-db2f-4c14-bb1b-fd9a6885573a/tool-results/bqmlwj47r.txt":"ea9f07e55ebb11e1e64e149cf688b89e448f4d8a","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/claim/claim.sh":"707f8ea05518fe3845c2d8ef7b8912a5c2f36ccd","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/pipeline/runner.sh":"640b4c0571bfe697f236a515f95be55b18d805f9","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/plugin.sh":"70e7aca83387ee35ec149c1cdf06100c46f089f8","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core":"tree:65e4a48c66a9284bb91ee1fd0fd7d6c041ea2fd9","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/event-bus/event-bus.sh":"61462a1a2cdd0ba3cdf09591604fd78a7e9ac15f","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/tests/claim-coordinator-unit-test.sh":"fc