+#!/usr/bin/env bash
+# tests/unit/deploy-release-v2-result-test.sh — contract v2 for plugins/tool/deploy-release (#1849)
+# Covers: SPEC-8..10, SPEC-14, SPEC-16, SPEC-17, SPEC-19, SPEC-20, SPEC-21, SPEC-25
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
+
+# shellcheck source=../../scripts/lib/helpers.sh
+source "$REPO_ROOT/scripts/lib/helpers.sh"
+# shellcheck source=../../scripts/lib/test-helpers.sh
+source "$REPO_ROOT/scripts/lib/test-helpers.sh"
+
+print_test_header "deploy-release: result contract v2 (#1849)"
+setup_test_env "deploy-release-v2-result"
+
+export ZBUILD_EVENTS_DIR="$TEST_TEMP_DIR/events"
+export ZBUILD_EVENTS_JSONL="$ZBUILD_EVENTS_DIR/events.jsonl"
+export ZBUILD_EVENTS_DB="/dev/null"
+export ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json"
+mkdir -p "$ZBUILD_EVENTS_DIR"
+: > "$ZBUILD_EVENTS_JSONL"
+
+MANIFEST="$REPO_ROOT/plugins/tool/deploy-release/manifest.yaml"
+
+# ─── SPEC-8: manifest declares result_contract==2, valid_verdicts=[deployed,error] ──
+print_test_section "SPEC-8: manifest provides.result_contract==2 + valid_verdicts unchanged"
+
+_rc8="$(grep -c 'result_contract: 2' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-8] deploy-release manifest declares result_contract: 2" "1" "$_rc8"
+
+_vv8_deployed="$(grep -c '^\s*- deployed$' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-8] deploy-release manifest valid_verdicts contains deployed" "1" "$_vv8_deployed"
+
+_vv8_error="$(grep -c '^\s*- error$' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-8] deploy-release manifest valid_verdicts contains error" "1" "$_vv8_error"
+
+# ─── SPEC-17: manifest retains role and all four events ─────────────────────
+print_test_section "SPEC-17: manifest retains role==deploy_release_executor and all events"
+
+_role17="$(grep 'role:' "$MANIFEST" 2>/dev/null | grep -c 'deploy_release_executor' || true)"
+assert_eq "[SPEC-17] deploy-release manifest declares role: deploy_release_executor" "1" "$_role17"
+
+for _ev in "deploy.release.complete" "deploy.release.dry_run" "release.published" "release.tagged"; do
+    _evcount="$(grep -c "${_ev}" "$MANIFEST" 2>/dev/null || true)"
+    assert_eq "[SPEC-17] deploy-release manifest retains event: ${_ev}" "1" "$_evcount"
+done
+
+# ─── SPEC-19: tier_default:T0, no router block ───────────────────────────────
+print_test_section "SPEC-19: tier_default:T0 present, no router block"
+
+_tier19="$(grep -c 'tier_default: T0' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-19] deploy-release manifest has tier_default: T0" "1" "$_tier19"
+
+_router19="$(grep -c '^router:' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-19] deploy-release manifest has no router: block" "0" "$_router19"
+
+# ─── SPEC-20: at least one output with primary:true ──────────────────────────
+print_test_section "SPEC-20: deploy_result output has primary:true"
+
+_prim20="$(grep -c 'primary: true' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-20] deploy-release manifest has at least one output with primary: true" "1" "$_prim20"
+
+# ─── SPEC-21: no cleanup hook in manifest ────────────────────────────────────
+print_test_section "SPEC-21: hooks section has no cleanup key"
+
+_cleanup21="$(grep -c '^\s*cleanup:' "$MANIFEST" 2>/dev/null || true)"
+assert_eq "[SPEC-21] deploy-release manifest hooks section has no cleanup key" "0" "$_cleanup21"
+
+# ─── Source plugin ────────────────────────────────────────────────────────────
+# shellcheck source=../../plugins/tool/deploy-release/plugin.sh
+source "$REPO_ROOT/plugins/tool/deploy-release/plugin.sh"
+
+_setup_state() {
+    local tag="$1" has_pr_url="${2:-no}"
+    local d="$TEST_TEMP_DIR/run-${tag}"
+    mkdir -p "$d/artifacts"
+    printf '{"issue":1849,"branch":"zbuild/issue-1849"}\n' > "$d/pipeline-state.json"
+    if [[ "$has_pr_url" == "yes" ]]; then
+        printf 'https://github.com/mock/repo/pull/1849\n' > "$d/artifacts/pr-url.txt"
+    fi
+    printf '%s/pipeline-state.json' "$d"
+}
+
+_result_field() {
+    local f="$1" field="$2"
+    jq -r "${field} // empty" "$f" 2>/dev/null || true
+}
+
+# ─── SPEC-9 + SPEC-14: dry-run path ──────────────────────────────────────────
+print_test_section "SPEC-9/14: dry_run — verdict=deployed, result_contract:2, rc=0"
+
+_sf_dr="$(_setup_state dry_run yes)"
+_art_dr="$(dirname "$_sf_dr")/artifacts"
+export ZBUILD_DRY_RUN=1
+export ZBUILD_RUN_ID="test-run-1849"
+
+_rc_dr=0; ( deploy_release_run "deploy" "$_sf_dr" ) >/dev/null 2>&1 || _rc_dr=$?
+
+assert_eq "[SPEC-16] deploy_release_run dry_run returns rc=0" "0" "$_rc_dr"
+assert_file_exists "[SPEC-9] deploy-result.json written on dry_run" "$_art_dr/deploy-result.json"
+if [[ -f "$_art_dr/deploy-result.json" ]]; then
+    assert_eq "[SPEC-9] result_contract==2 on dry_run" "2" \
+        "$(_result_field "$_art_dr/deploy-result.json" '.result_contract')"
+    assert_eq "[SPEC-14] verdict==deployed on dry_run" "deployed" \
+        "$(_result_field "$_art_dr/deploy-result.json" '.verdict')"
+    assert_eq "[SPEC-9] disposition==complete on dry_run" "complete" \
+        "$(_result_field "$_art_dr/deploy-result.json" '.disposition')"
+    _r_dr="$(_result_field "$_art_dr/deploy-result.json" '.reason')"
+    [[ -n "$_r_dr" ]] && assert_pass "[SPEC-9] reason non-empty on dry_run" \
+        || assert_fail "[SPEC-9] reason non-empty on dry_run" "empty"
+fi
+unset ZBUILD_DRY_RUN
+
+# ─── SPEC-9 + SPEC-16: tag success path ──────────────────────────────────────
+print_test_section "SPEC-9/16: tag_success — verdict=deployed, rc=0"
+
+_sf_ts="$(_setup_state tag_success yes)"
+_art_ts="$(dirname "$_sf_ts")/artifacts"
+git() {
+    case "${1:-} ${2:-}" in
+        "tag zbuild-run") return 0 ;;
+        "tag "*)  return 0 ;;
+        "push origin") return 0 ;;
+        *) return 0 ;;
+    esac
+}
+export -f git
+
+_rc_ts=0; ( deploy_release_run "deploy" "$_sf_ts" ) >/dev/null 2>&1 || _rc_ts=$?
+
+assert_eq "[SPEC-16] deploy_release_run tag_success returns rc=0" "0" "$_rc_ts"
+if [[ -f "$_art_ts/deploy-result.json" ]]; then
+    assert_eq "[SPEC-9] result_contract==2 on tag_success" "2" \
+        "$(_result_field "$_art_ts/deploy-result.json" '.result_contract')"
+    assert_eq "[SPEC-9] verdict==deployed on tag_success" "deployed" \
+        "$(_result_field "$_art_ts/deploy-result.json" '.verdict')"
+    _r_ts="$(_result_field "$_art_ts/deploy-result.json" '.reason')"
+    [[ -n "$_r_ts" ]] && assert_pass "[SPEC-9] reason non-empty on tag_success" \
+        || assert_fail "[SPEC-9] reason non-empty on tag_success" "empty"
+fi
+unset -f git
+
+# ─── SPEC-9 + SPEC-16: tag_failed path ───────────────────────────────────────
+print_test_section "SPEC-9/16: tag_failed — verdict=error, rc=1 (not 2)"
+
+_sf_tf="$(_setup_state tag_failed no)"
+_art_tf="$(dirname "$_sf_tf")/artifacts"
+git() {
+    case "${1:-} ${2:-}" in
+        "tag "*)  echo "tag already exists" >&2; return 1 ;;
+        *) return 0 ;;
+    esac
+}
+export -f git
+
+_rc_tf=0; ( deploy_release_run "deploy" "$_sf_tf" ) >/dev/null 2>&1 || _rc_tf=$?
+
+assert_eq "[SPEC-16] deploy_release_run tag_failed returns rc=1 (not 2)" "1" "$_rc_tf"
+if [[ -f "$_art_tf/deploy-result.json" ]]; then
+    assert_eq "[SPEC-9] result_contract==2 on tag_failed" "2" \
+        "$(_result_field "$_art_tf/deploy-result.json" '.result_contract')"
+    assert_eq "[SPEC-9] verdict==error on tag_failed" "error" \
+        "$(_result_field "$_art_tf/deploy-result.json" '.verdict')"
+    _r_tf="$(_result_field "$_art_tf/deploy-result.json" '.reason')"
+    [[ -n "$_r_tf" ]] && assert_pass "[SPEC-9] reason non-empty on tag_failed" \
+        || assert_fail "[SPEC-9] reason non-empty on tag_failed" "empty"
+fi
+unset -f git
+
+# ─── SPEC-9 + SPEC-16: push_failed path ──────────────────────────────────────
+print_test_section "SPEC-9/16: push_failed — verdict=error, rc=1"
+
+_sf_pf="$(_setup_state push_failed no)"
+_art_pf="$(dirname "$_sf_pf")/artifacts"
+git() {
+    case "${1:-} ${2:-}" in
+        "tag "*)  return 0 ;;
+        "push origin"*) echo "push failed" >&2; return 1 ;;
+        "tag -d"*) return 0 ;;
+        *) return 0 ;;
+    esac
+}
+export -f git
+
+_rc_pf=0; ( deploy_release_run "deploy" "$_sf_pf" ) >/dev/null 2>&1 || _rc_pf=$?
+
+assert_eq "[SPEC-16] deploy_release_run push_failed returns rc=1" "1" "$_rc_pf"
+if [[ -f "$_art_pf/deploy-result.json" ]]; then
+    assert_eq "[SPEC-9] result_contract==2 on push_failed" "2" \
+        "$(_result_field "$_art_pf/deploy-result.json" '.result_contract')"
+    assert_eq "[SPEC-9] verdict==error on push_failed" "error" \
+        "$(_result_field "$_art_pf/deploy-result.json" '.verdict')"
+    _r_pf="$(_result_field "$_art_pf/deploy-result.json" '.reason')"
+    [[ -n "$_r_pf" ]] && assert_pass "[SPEC-9] reason non-empty on push_failed" \
+        || assert_fail "[SPEC-9] reason non-empty on push_failed" "empty"
+fi
+unset -f git
+
+# ─── SPEC-10: ZBUILD_STAGE_INPUTS lookup for pr_url ─────────────────────────
+print_test_section "SPEC-10: pr_url resolved from ZBUILD_STAGE_INPUTS"
+
+_sf_s10="$(_setup_state spec10 no)"
+_art_s10="$(dirname "$_sf_s10")/artifacts"
+_custom_pr_url="$TEST_TEMP_DIR/custom-pr-url.txt"
+printf 'https://github.com/mock/repo/pull/1849\n' > "$_custom_pr_url"
+export ZBUILD_STAGE_INPUTS='{"inputs":{"pr_url":"'"$_custom_pr_url"'"}}'
+export ZBUILD_DRY_RUN=1
+
+_rc_s10=0; ( deploy_release_run "deploy" "$_sf_s10" ) >/dev/null 2>&1 || _rc_s10=$?
+
