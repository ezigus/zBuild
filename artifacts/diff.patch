+    ZBUILD_EVENTS_DIR="$_DSPK_LEAF_EVENTS_DIR" \
+    ZBUILD_EVENTS_JSONL="$_DSPK_LEAF_EVENTS_JSONL" \
+    ZBUILD_EVENT_SCHEMA="$REPO_ROOT/config/event-schema.json" \
