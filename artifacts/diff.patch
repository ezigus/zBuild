+            regressed)       printf 'GUARD FAIL %s guard_regressed\n' "$spec_id"; rc=1 ;;
+            timeout|harness) printf 'GUARD SKIP %s %s\n' "$spec_id" "$out" ;;
+            *)               printf 'GUARD PASS %s\n' "$spec_id" ;;
+        esac
+    done
+    return "$rc"
+}
