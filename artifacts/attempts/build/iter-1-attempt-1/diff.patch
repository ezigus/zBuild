+# ─── SPEC-5 + SPEC-6: no_review_signal ───────────────────────────────────────
+print_test_section "SPEC-5/6: no_review_signal — verdict=blocked (fail-closed), rc=1"
+
+_sf_nr="$(_setup_state no_review no no)"
+_art_nr="$(dirname "$_sf_nr")/artifacts"
+_mock_git_pass
+
+_rc_nr=0; ( pr_open_run "pr" "$_sf_nr" ) >/dev/null 2>&1 || _rc_nr=$?
