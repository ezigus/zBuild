+    for spec_id in "${guards[@]}"; do
+        local -a _tfs=()
+        while IFS= read -r tf; do
+            [[ -n "$tf" ]] && _tfs+=("$tf")
+        done < <(_negctl_guard_resolve_tfs "$design_md" "$repo_root" "$spec_id" \
