+        "$raw_out" json _rr_lp_prose
     if [[ -z "$json" ]] || ! printf '%s' "$json" | jq empty >/dev/null 2>&1; then
         emit_event "review_report.lens.unparseable" "lens=$lens" 2>/dev/null || true
         printf '%s' "$empty"; return 0
@@ -201,14 +220,14 @@ _rr_lens_evidence() {
     return 0
 }
 
