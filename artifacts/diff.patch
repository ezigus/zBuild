+    # The declared pool, for guards that carry no per-SPEC binding.
+    local -a testfiles=()
+    local tf
+    while IFS= read -r tf; do
+        [[ -n "$tf" && -f "$repo_root/$tf" ]] && testfiles+=("$tf")
+    done < <(acceptance_list_testfiles "$design_md" 2>/dev/null || true)
