{"lens":{"fp":"582387034-24986","payload":"{\"score\": 8, \"findings\": [{\"file\": \"core/pipeline/runner.sh\", \"category\": \"unsanitized outside input in log output\", \"severity\": \"medium\", \"message\": \"The holder string extracted from a GitHub issue comment by _ccgl_read_holder is passed to error(), which uses `echo -e \\\"… $*\\\"`, so backslash sequences (\\\\n, \\\\033[…) in the holder are interpreted by echo, allowing a crafted run-status comment to inject fake log lines or terminal control sequences into the operator's stderr.\", \"quote\": \"error \\\"issue ${_runner_issue:-} is already claimed: ${_ZBUILD_CLAIM_HOLDER:-unknown}\\\"\", \"trigger\": \"A GitHub issue comment whose <!-- zbuild-holder: --> field contains backslash escape sequences such as \\\\n or \\\\033[31m; this comment is fetched by _ccgl_read_holder via `gh issue comment list` and its content stored in _ZBUILD_CLAIM_HOLDER before the error() call.\", \"introduced\": true, \"fix\": \"code\"}]}","files":{"/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/scripts/lib/helpers.sh":"d3dcab9ec5f8d9e6d76932f5c8d7c02c09c97cbf","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/config/event-schema.json":"30dce672627cb047400df8eb0e095c14e8917247","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/scripts/lib/logging.sh":"absent","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/plugins/claim-coordinator/github-labels/plugin.sh":"2e2649a7ef6be6c9ab172921cc93401399968c6a","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/core/event-bus/event-bus.sh":"61462a1a2cdd0ba3cdf09591604fd78a7e9ac15f","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/scripts/lib/run-status-render.sh":"e66946ae97fcf967c5f77ee2ea2518de3b7fda3b","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree/scripts/lib":"tree:bb1a60991820c98516449a24f69b43887a82a916","/home/runner/.zbuild/repos/ezigus/zBuild/issues/1764/worktree":"tree:719d8f52968e255