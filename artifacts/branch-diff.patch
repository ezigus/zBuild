+        "found: ${_s13_count:-0}"
+fi
+_s13_required=(
+    "intake.baseline.captured"
+    "intake.branch.adopted"
+    "intake.branch.created"
+    "intake.branch.from_detached"
+    "intake.branch.noop"
+    "intake.branch.reclaim_refused"
+    "intake.branch.reclaimed"
+    "intake.branch.reused"
+    "intake.error"
