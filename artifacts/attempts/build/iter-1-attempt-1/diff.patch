-            [[ "$_tm" =~ ^[0-7]{3,4}$ ]] || _tm="$(stat -f '%Lp' "$_tm_t" 2>/dev/null || true)"
+        else
+            _tm="$(stat -f '%Lp' "$_tm_t" 2>/dev/null || true)"
         fi
