+    assert_fail "[SPEC-18b] direct handler: verdict=error (file absent)"
+    assert_fail "[SPEC-18b] direct handler: disposition=interrupted (file absent)"
+fi
+
+# (c) kill -TERM "$$" in a mock route_to_model — SIGTERM fires the registered
