+assert_gt "[#1835/SPEC-7] plan.json steps[] non-empty (guard)" "$_s7_steps" "0"
+_s7_sf_len="$(printf '%s' "$_s7_json" | jq '.scope_files | length' 2>/dev/null || echo 0)"
