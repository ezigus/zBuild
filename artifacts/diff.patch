+    local evidence_file="$2" artifact_dir="$3" tier="${4:-T2}" budget_guidance="${5:-}"
     local max="${ZBUILD_RR_MAX_PARALLEL:-4}"
     [[ "$max" -ge 1 ]] 2>/dev/null || max=1
